@{
    ViewData["Title"] = "Настройки";

    var email = ViewBag.Email as string ?? "";
    var userName = ViewBag.UserName as string ?? "";
    var displayName = ViewBag.DisplayName as string ?? userName;

    var firstLetter = string.IsNullOrWhiteSpace(displayName)
        ? "?"
        : displayName.Substring(0, 1).ToUpper();

    var isAdmin = User.IsInRole("Admin");
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/Account/Settings.css"
          asp-append-version="true" />
}

<div class="settings-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header class="settings-header">

        <div class="settings-header-left">

            <a asp-controller="Account"
               asp-action="Profile"
               class="settings-back-button"
               aria-label="Назад">

                <span>‹</span>

            </a>

            <div class="settings-header-title">

                <h1>
                    Настройки
                </h1>

                <p>
                    Управление профилем и параметрами ScheduleSystem
                </p>

            </div>

        </div>

    </header>


    <!-- =========================================================
         MESSAGES
         ========================================================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="settings-message settings-message-success">

            <span class="settings-message-icon">
                ✓
            </span>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }


    @if (TempData["ProgramMessage"] != null)
    {
        <div class="settings-message settings-message-success">

            <span class="settings-message-icon">
                ✓
            </span>

            <span>
                @TempData["ProgramMessage"]
            </span>

        </div>
    }


    <!-- =========================================================
         TABS
         ========================================================= -->

    <nav class="settings-tabs"
         aria-label="Разделы настроек">

        <button type="button"
                class="settings-tab active"
                data-tab="profile"
                aria-selected="true">

            <span class="settings-tab-icon">
                👤
            </span>

            <span>
                Профиль
            </span>

        </button>


        @if (isAdmin)
        {
            <button type="button"
                    class="settings-tab"
                    data-tab="program"
                    aria-selected="false">

                <span class="settings-tab-icon">
                    ⚙️
                </span>

                <span>
                    Программа
                </span>

            </button>
        }


        <button type="button"
                class="settings-tab"
                data-tab="about"
                aria-selected="false">

            <span class="settings-tab-icon">
                ⓘ
            </span>

            <span>
                О программе
            </span>

        </button>

    </nav>


    <!-- =========================================================
         PROFILE TAB
         ========================================================= -->

    <section class="settings-tab-content active"
             data-tab-content="profile">

        <!-- =====================================================
             PROFILE
             ===================================================== -->

        <div class="settings-section">

            <div class="settings-section-header">

                <div>

                    <h2>
                        Профиль
                    </h2>

                    <p>
                        Основная информация вашей учётной записи
                    </p>

                </div>

            </div>


            <div class="settings-card">

                <div class="settings-profile-preview">

                    <div class="settings-avatar">
                        @firstLetter
                    </div>

                    <div class="settings-profile-info">

                        <strong>
                            @displayName
                        </strong>

                        <span>
                            @email
                        </span>

                        <span class="settings-role">
                            @(isAdmin
                                ? "Администратор"
                                : "Пользователь")
                        </span>

                    </div>

                </div>


                <form asp-controller="Account"
                      asp-action="UpdateProfile"
                      method="post"
                      class="settings-form">

                    @Html.AntiForgeryToken()

                    <div class="settings-form-grid">

                        <div class="settings-field">

                            <label for="displayName">
                                Имя
                            </label>

                            <input type="text"
                                   id="displayName"
                                   name="displayName"
                                   class="settings-input"
                                   value="@displayName"
                                   maxlength="100" />

                        </div>


                        <div class="settings-field">

                            <label for="email">
                                Электронная почта
                            </label>

                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="settings-input"
                                   value="@email"
                                   maxlength="254" />

                        </div>

                    </div>


                    <div class="settings-form-actions">

                        <button type="submit"
                                class="settings-save-button">

                            Сохранить изменения

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- =====================================================
             SECURITY
             ===================================================== -->

        <div class="settings-section">

            <div class="settings-section-header">

                <div>

                    <h2>
                        Безопасность
                    </h2>

                    <p>
                        Управление паролем учётной записи
                    </p>

                </div>

            </div>


            <div class="settings-card settings-action-card">

                <div class="settings-action-icon">
                    🔐
                </div>

                <div class="settings-action-content">

                    <strong>
                        Изменить пароль
                    </strong>

                    <span>
                        Обновите пароль вашей учётной записи
                    </span>

                </div>

                <a asp-controller="Account"
                   asp-action="ChangePassword"
                   class="settings-secondary-button">

                    Изменить

                </a>

            </div>

        </div>


        <!-- =====================================================
             APPEARANCE
             ===================================================== -->

        <div class="settings-section">

            <div class="settings-section-header">

                <div>

                    <h2>
                        Внешний вид
                    </h2>

                    <p>
                        Настройка интерфейса приложения
                    </p>

                </div>

            </div>


            <div class="settings-card settings-action-card">

                <div class="settings-action-icon">
                    ✨
                </div>

                <div class="settings-action-content">

                    <strong>
                        Интерфейс
                    </strong>

                    <span>
                        Дополнительные настройки внешнего вида
                    </span>

                </div>

                <span class="settings-soon">
                    Скоро
                </span>

            </div>

        </div>

    </section>


    <!-- =========================================================
         PROGRAM TAB
         ========================================================= -->

    @if (isAdmin)
    {
        <section class="settings-tab-content"
                 data-tab-content="program">

            <!-- =================================================
                 STUDY LOAD
                 ================================================= -->

            <div class="settings-section">

                <div class="settings-section-header">

                    <div>

                        <h2>
                            Учебная нагрузка
                        </h2>

                        <p>
                            Настройка предметов и количества занятий
                            для каждой учебной группы.
                        </p>

                    </div>

                </div>


                <div class="settings-card settings-action-card">

                    <div class="settings-action-icon">
                        📚
                    </div>


                    <div class="settings-action-content">

                        <strong>
                            Управление учебной нагрузкой
                        </strong>

                        <span>
                            Выберите группу, добавьте предметы
                            и укажите количество занятий в неделю.
                        </span>

                    </div>


                    <a asp-controller="Account"
                       asp-action="StudyLoad"
                       class="settings-secondary-button">

                        Настроить

                    </a>

                </div>

            </div>


            <!-- =================================================
                 HISTORY
                 ================================================= -->

            <div class="settings-section">

                <div class="settings-section-header">

                    <div>

                        <h2>
                            История изменений
                        </h2>

                        <p>
                            Просмотр действий пользователей системы.
                        </p>

                    </div>

                </div>


                <div class="settings-card settings-action-card">

                    <div class="settings-action-icon">
                        🕘
                    </div>

                    <div class="settings-action-content">

                        <strong>
                            Журнал действий
                        </strong>

                        <span>
                            Просмотр истории изменений расписания
                            и данных системы.
                        </span>

                    </div>


                    <a asp-controller="AuditLogs"
                       asp-action="Index"
                       class="settings-secondary-button">

                        Открыть

                    </a>

                </div>

            </div>


            <!-- =================================================
                 MAINTENANCE
                 ================================================= -->

            <div class="settings-section">

                <div class="settings-section-header">

                    <div>

                        <h2>
                            Обслуживание
                        </h2>

                        <p>
                            Управление и очистка данных программы.
                        </p>

                    </div>

                </div>


                <div class="settings-card settings-maintenance-card">

                    <!-- CLEAR SCHEDULE -->

                    <div class="settings-action-card">

                        <div class="settings-action-icon">
                            🗑️
                        </div>

                        <div class="settings-action-content">

                            <strong>
                                Очистить расписание
                            </strong>

                            <span>
                                Удалить все созданные занятия,
                                сохранив группы, преподавателей,
                                предметы и аудитории.
                            </span>

                        </div>


                        <button type="button"
                                class="settings-danger-button"
                                data-modal-open="clearScheduleModal">

                            Очистить

                        </button>

                    </div>


                    <!-- CLEAR ALL DATA -->

                    <div class="settings-action-card">

                        <div class="settings-action-icon">
                            ⚠️
                        </div>

                        <div class="settings-action-content">

                            <strong>
                                Очистить все данные
                            </strong>

                            <span>
                                Полностью удалить данные программы.
                                Это действие нельзя отменить.
                            </span>

                        </div>


                        <button type="button"
                                class="settings-danger-button"
                                data-modal-open="clearAllDataModal">

                            Очистить всё

                        </button>

                    </div>

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         ABOUT TAB
         ========================================================= -->

    <section class="settings-tab-content"
             data-tab-content="about">

        <div class="settings-section">

            <div class="settings-section-header">

                <div>

                    <h2>
                        О программе
                    </h2>

                    <p>
                        Информация о системе ScheduleSystem
                    </p>

                </div>

            </div>


            <div class="settings-about-card settings-card">

                <!-- HERO -->

                <div class="settings-about-hero">

                    <div class="settings-about-logo">
                        📅
                    </div>

                    <div>

                        <h2>
                            ScheduleSystem
                        </h2>

                        <p>
                            Система управления учебным расписанием
                            образовательного учреждения.
                        </p>

                        <div class="settings-about-version">
                            Версия 1.0
                        </div>

                    </div>

                </div>


                <!-- DESCRIPTION -->

                <div class="settings-about-description">

                    <h3>
                        О системе
                    </h3>

                    <p>
                        ScheduleSystem предназначена для создания,
                        управления и просмотра учебного расписания.
                        Система объединяет данные о группах,
                        преподавателях, предметах и аудиториях
                        в едином интерфейсе.
                    </p>

                    <p>
                        Программа позволяет создавать расписание
                        вручную, проверять конфликты, учитывать
                        ограничения аудиторий, преподавателей и
                        учебных групп.
                    </p>

                </div>


                <!-- FEATURES -->

                <div class="settings-about-features">

                    <h3>
                        Основные возможности
                    </h3>


                    <div class="settings-about-feature-grid">

                        <div class="settings-about-feature">

                            <span>
                                📅
                            </span>

                            <div>

                                <strong>
                                    Расписание
                                </strong>

                                <p>
                                    Создание, просмотр и управление
                                    учебными занятиями.
                                </p>

                            </div>

                        </div>


                        <div class="settings-about-feature">

                            <span>
                                👥
                            </span>

                            <div>

                                <strong>
                                    Группы
                                </strong>

                                <p>
                                    Управление учебными группами
                                    и их учебной нагрузкой.
                                </p>

                            </div>

                        </div>


                        <div class="settings-about-feature">

                            <span>
                                👨‍🏫
                            </span>

                            <div>

                                <strong>
                                    Преподаватели
                                </strong>

                                <p>
                                    Хранение информации о преподавателях
                                    и их предметах.
                                </p>

                            </div>

                        </div>


                        <div class="settings-about-feature">

                            <span>
                                🏫
                            </span>

                            <div>

                                <strong>
                                    Аудитории
                                </strong>

                                <p>
                                    Учёт помещений и их вместимости.
                                </p>

                            </div>

                        </div>


                        <div class="settings-about-feature">

                            <span>
                                🛡️
                            </span>

                            <div>

                                <strong>
                                    Проверка конфликтов
                                </strong>

                                <p>
                                    Контроль пересечений занятий,
                                    вместимости и требований аудиторий.
                                </p>

                            </div>

                        </div>


                        <div class="settings-about-feature">

                            <span>
                                📊
                            </span>

                            <div>

                                <strong>
                                    Экспорт
                                </strong>

                                <p>
                                    Подготовка расписания
                                    в различных форматах.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- TECHNOLOGIES -->

                <div class="settings-about-tech">

                    <h3>
                        Технологии
                    </h3>

                    <div class="settings-tech-list">

                        <span>
                            ASP.NET Core
                        </span>

                        <span>
                            C#
                        </span>

                        <span>
                            Entity Framework Core
                        </span>

                        <span>
                            PostgreSQL
                        </span>

                        <span>
                            HTML / CSS / JavaScript
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CLEAR SCHEDULE MODAL
         ========================================================= -->

    @if (isAdmin)
    {
        <div id="clearScheduleModal"
             class="settings-modal"
             hidden>

            <div class="settings-modal-backdrop"
                 data-modal-close>
            </div>


            <div class="settings-modal-content"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="clearScheduleTitle">

                <button type="button"
                        class="settings-modal-close"
                        data-modal-close
                        aria-label="Закрыть">

                    ×

                </button>


                <div class="settings-modal-icon">
                    ⚠️
                </div>


                <h2 id="clearScheduleTitle">
                    Очистить расписание?
                </h2>


                <p>
                    Все созданные занятия будут удалены.
                    Группы, преподаватели, предметы и аудитории
                    останутся в системе.
                </p>


                <form asp-controller="Account"
                      asp-action="ClearSchedule"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="settings-modal-actions">

                        <button type="button"
                                class="settings-secondary-button"
                                data-modal-close>

                            Отмена

                        </button>


                        <button type="submit"
                                class="settings-danger-button">

                            Очистить расписание

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- =====================================================
             CLEAR ALL DATA MODAL
             ===================================================== -->

        <div id="clearAllDataModal"
             class="settings-modal"
             hidden>

            <div class="settings-modal-backdrop"
                 data-modal-close>
            </div>


            <div class="settings-modal-content"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="clearAllDataTitle">

                <button type="button"
                        class="settings-modal-close"
                        data-modal-close
                        aria-label="Закрыть">

                    ×

                </button>


                <div class="settings-modal-icon">
                    🛑
                </div>


                <h2 id="clearAllDataTitle">
                    Удалить все данные?
                </h2>


                <p>
                    Будут удалены расписание, группы, преподаватели,
                    предметы и аудитории.
                    Это действие нельзя отменить.
                </p>


                <form asp-controller="Account"
                      asp-action="ClearAllData"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="settings-modal-actions">

                        <button type="button"
                                class="settings-secondary-button"
                                data-modal-close>

                            Отмена

                        </button>


                        <button type="submit"
                                class="settings-danger-button">

                            Удалить всё

                        </button>

                    </div>

                </form>

            </div>

        </div>
    }

</div>


<!-- =============================================================
     SETTINGS JAVASCRIPT
     ============================================================= -->

<script src="~/js/Account/Settings.js"
        asp-append-version="true"></script>

