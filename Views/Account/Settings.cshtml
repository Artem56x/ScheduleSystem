@{
    ViewData["Title"] = "Настройки";

    var email = ViewBag.Email as string ?? "";
    var userName = ViewBag.UserName as string ?? email;
    var displayName = ViewBag.DisplayName as string ?? "";

    var firstLetter = !string.IsNullOrWhiteSpace(email)
        ? email.Substring(0, 1).ToUpper()
        : "U";

    bool isAdmin = ViewBag.IsAdmin == true;

    var teacherCount = ViewBag.TeacherCount ?? 0;
    var groupCount = ViewBag.GroupCount ?? 0;
    var subjectCount = ViewBag.SubjectCount ?? 0;
    var classroomCount = ViewBag.ClassroomCount ?? 0;
    var scheduleCount = ViewBag.ScheduleCount ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Account/Settings.css" asp-append-version="true" />
}

<div class="settings-page">

    <div class="settings-container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="settings-header">

            <div class="settings-header-left">

                <a asp-controller="Account" asp-action="Profile" class="settings-back" title="Вернуться в профиль">

                    ←
                </a>

                <div class="settings-title-block">

                    <h1>
                        Настройки
                    </h1>

                    <p>
                        Управление аккаунтом и параметрами ScheduleSystem
                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SUCCESS MESSAGE
             ===================================================== -->

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="settings-alert settings-alert-success">

                <span>✓</span>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>
        }


        @if (TempData["ProgramMessage"] != null)
        {
            <div class="settings-alert settings-alert-success">

                <span>✓</span>

                <span>
                    @TempData["ProgramMessage"]
                </span>

            </div>
        }


        <!-- =====================================================
             TABS
             ===================================================== -->

        <div class="settings-tabs">

            <!-- PROFILE -->

            <button type="button" class="settings-tab active" data-tab="profile">

                <span class="settings-tab-icon">
                    👤
                </span>

                <span>
                    Настройки профиля
                </span>

            </button>


            <!-- PROGRAM — ADMIN ONLY -->

            @if (isAdmin)
            {
                <button type="button" class="settings-tab" data-tab="program">

                    <span class="settings-tab-icon">
                        ⚙️
                    </span>

                    <span>
                        Настройки программы
                    </span>

                </button>
            }


            <!-- ABOUT -->

            <button type="button" class="settings-tab" data-tab="about">

                <span class="settings-tab-icon">
                    ℹ️
                </span>

                <span>
                    О программе
                </span>

            </button>

        </div>


        <!-- =====================================================
             TAB: PROFILE
             ===================================================== -->

        <div class="settings-tab-content active" id="tab-profile">


            <!-- ACCOUNT -->

            <div class="glass-settings-card">

                <div class="settings-card-header">

                    <div class="settings-icon">
                        👤
                    </div>

                    <div>

                        <h2>
                            Учётная запись
                        </h2>

                        <p>
                            Основная информация вашего аккаунта
                        </p>

                    </div>

                </div>


                <form asp-controller="Account" asp-action="UpdateProfile" method="post" class="settings-form">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="settings-validation-summary">
                    </div>


                    <!-- EMAIL -->

                    <div class="settings-field">

                        <label for="email">
                            Email
                        </label>

                        <div class="settings-input-wrapper">

                            <span class="settings-avatar">
                                @firstLetter
                            </span>

                            <input type="email" id="email" name="email" value="@email" class="settings-input"
                                   autocomplete="email" placeholder="Введите Email" required />

                        </div>

                        <small class="settings-description">
                            Используется для входа в аккаунт.
                        </small>

                    </div>


                    <!-- DISPLAY NAME -->

                    <div class="settings-field">

                        <label for="displayName">
                            Имя пользователя
                        </label>

                        <input type="text" id="displayName" name="displayName" value="@displayName"
                               class="settings-input" maxlength="100" autocomplete="name" placeholder="Например, Артём"
                               required />

                        <small class="settings-description">
                            Это имя будет отображаться в вашем профиле.
                        </small>

                    </div>


                    <!-- ROLE -->

                    <div class="settings-field">

                        <label>
                            Роль
                        </label>

                        <div class="settings-static-value">

                            @if (isAdmin)
                            {
                                <span class="settings-role admin">
                                    Администратор
                                </span>
                            }
                            else
                            {
                                <span class="settings-role">
                                    Пользователь
                                </span>
                            }

                        </div>

                    </div>


                    <!-- SAVE -->

                    <div class="settings-save-container">

                        <button type="submit" class="settings-save-button">

                            Сохранить изменения

                        </button>

                    </div>

                </form>

            </div>


            <!-- SECURITY -->

            <div class="glass-settings-card">

                <div class="settings-card-header">

                    <div class="settings-icon">
                        🔐
                    </div>

                    <div>

                        <h2>
                            Безопасность
                        </h2>

                        <p>
                            Управление доступом к аккаунту
                        </p>

                    </div>

                </div>


                <div class="settings-option">

                    <div class="option-left">

                        <div class="option-icon">
                            🔑
