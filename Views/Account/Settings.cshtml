@{
    ViewData["Title"] = "Настройки";

    var email = ViewBag.Email as string ?? "";
    var userName = ViewBag.UserName as string ?? "";
    var displayName = ViewBag.DisplayName as string ?? userName;

    var firstLetter = string.IsNullOrWhiteSpace(displayName)
        ? "?"
        : displayName.Substring(0, 1).ToUpper();

    var isAdmin = User.IsInRole("Admin");
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Account/Settings.css" asp-append-version="true" />
}

<div class="settings-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="settings-header">

        <div class="settings-header-content">
            <h1>Настройки</h1>
            <p>Управление профилем и параметрами ScheduleSystem</p>
        </div>

    </header>


    <!-- =====================================================
         MESSAGES
         ===================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="settings-message settings-message-success">
            <span class="settings-message-icon">✓</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ProgramMessage"] != null)
    {
        <div class="settings-message settings-message-success">
            <span class="settings-message-icon">✓</span>
            <span>@TempData["ProgramMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="settings-message settings-message-error" role="alert">
            <span class="settings-message-icon">!</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }


    <!-- =====================================================
         TABS
         ===================================================== -->

    <nav class="settings-tabs" aria-label="Разделы настроек">

        <button type="button" class="settings-tab active" data-tab="profile" aria-selected="true">

            <span class="settings-tab-icon">👤</span>
            <span>Профиль</span>

        </button>


        @if (isAdmin)
        {
            <button type="button" class="settings-tab" data-tab="program" aria-selected="false">

                <span class="settings-tab-icon">⚙</span>
                <span>Программа</span>

            </button>
        }


        <button type="button" class="settings-tab" data-tab="about" aria-selected="false">

            <span class="settings-tab-icon">ⓘ</span>
            <span>О программе</span>

        </button>

    </nav>


    <!-- =====================================================
         PROFILE
         ===================================================== -->

    <section class="settings-tab-content active" data-tab-content="profile">

        <div class="settings-panel">

            <div class="settings-panel-header">

                <div class="settings-panel-title">
                    <div class="settings-panel-icon">
                        👤
                    </div>

                    <div>
                        <h2>Профиль</h2>
                        <p>Основная информация вашей учётной записи</p>
                    </div>
                </div>

            </div>


            <div class="settings-divider"></div>


            <!-- Profile preview -->

            <div class="settings-profile-preview">

                <div class="settings-avatar">
                    @firstLetter
                </div>

                <div class="settings-profile-info">

                    <strong>@displayName</strong>

                    <span>@email</span>

                    <span class="settings-role">
                        @(isAdmin ? "Администратор" : "Пользователь")
                    </span>

                </div>

            </div>


            <!-- Profile form -->

            <form asp-controller="Account" asp-action="UpdateProfile" method="post" class="settings-form">

                @Html.AntiForgeryToken()

                <div class="settings-form-grid">

                    <div class="settings-field">

                        <label for="displayName">
                            Имя
                        </label>

                        <input type="text" id="displayName" name="displayName" class="settings-input"
                               value="@displayName" maxlength="100" />

                    </div>


                    <div class="settings-field">

                        <label for="email">
                            Электронная почта
                        </label>

                        <input type="email" id="email" name="email" class="settings-input" value="@email"
                               maxlength="254" />

                    </div>

                </div>


                <div class="settings-form-actions">

                    <button type="submit" class="settings-save-button">

                        Сохранить изменения

                    </button>

                </div>

            </form>


            <div class="settings-divider"></div>


            <!-- Security -->

            <div class="settings-action-row">

                <div class="settings-action-left">

                    <div class="settings-action-icon">
                        🔐
                    </div>

                    <div class="settings-action-content">

                        <strong>Изменить пароль</strong>

                        <span>
                            Обновите пароль вашей учётной записи
                        </span>

                    </div>

                </div>

                <a asp-controller="Account" asp-action="ChangePassword" class="settings-secondary-button">

                    Изменить

                </a>

            </div>


            <div class="settings-divider"></div>


            <!-- Appearance -->

            <div class="settings-action-row">

                <div class="settings-action-left">

                    <div class="settings-action-icon">
                        ✨
                    </div>

                    <div class="settings-action-content">

                        <strong>Внешний вид</strong>

                        <span>
                            Дополнительные настройки интерфейса
                        </span>

                    </div>

                </div>

                <span class="settings-soon">
                    Скоро
                </span>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PROGRAM
         ===================================================== -->

    @if (isAdmin)
    {
        <section class="settings-tab-content" data-tab-content="program">

            <div class="settings-panel">

                <div class="settings-panel-header">

                    <div class="settings-panel-title">

                        <div class="settings-panel-icon">
                            ⚙
                        </div>

                        <div>
                            <h2>Программа</h2>
                            <p>Управление параметрами ScheduleSystem</p>
                        </div>

                    </div>

                </div>


                <div class="settings-divider"></div>


                <!-- Study load -->

                <div class="settings-action-row">

                    <div class="settings-action-left">

                        <div class="settings-action-icon">
                            📚
                        </div>

                        <div class="settings-action-content">

                            <strong>Учебная нагрузка</strong>

                            <span>
                                Настройка предметов и количества занятий
                                для каждой учебной группы
                            </span>

                        </div>

                    </div>

                    <a asp-controller="Account" asp-action="StudyLoad" class="settings-secondary-button">

                        Настроить

                    </a>

                </div>


                <div class="settings-divider"></div>


                <!-- Audit logs -->

                <div class="settings-action-row">

                    <div class="settings-action-left">

                        <div class="settings-action-icon">
                            🕘
                        </div>

                        <div class="settings-action-content">

                            <strong>История изменений</strong>

                            <span>
                                Просмотр действий пользователей системы
                            </span>

                        </div>

                    </div>

                    <a asp-controller="AuditLogs" asp-action="Index" class="settings-secondary-button">

                        Открыть

                    </a>

                </div>


                <div class="settings-divider"></div>


                <!-- Maintenance -->

                <div class="settings-subsection">

                    <div class="settings-subsection-header">

                        <h3>Обслуживание</h3>

                        <p>
                            Управление и очистка данных программы
                        </p>

                    </div>


                    <div class="settings-maintenance-row">

                        <div class="settings-action-left">

                            <div class="settings-action-icon settings-action-icon-danger">
                                🗑
                            </div>

                            <div class="settings-action-content">

                                <strong>Очистить расписание</strong>

                                <span>
                                    Удалить созданные занятия,
                                    сохранив основные данные системы
                                </span>

                            </div>

                        </div>

                        <button type="button" class="settings-danger-button" data-modal-open="clearScheduleModal">

                            Очистить

                        </button>

                    </div>


                    <div class="settings-maintenance-row">

                        <div class="settings-action-left">

                            <div class="settings-action-icon settings-action-icon-danger">
                                ⚠
                            </div>

                            <div class="settings-action-content">

                                <strong>Очистить все данные</strong>

                                <span>
                                    Полностью удалить данные программы.
                                    Это действие нельзя отменить
                                </span>

                            </div>

                        </div>

                        <button type="button" class="settings-danger-button" data-modal-open="clearAllDataModal">

                            Очистить всё

                        </button>

                    </div>

                </div>

            </div>

        </section>
    }


    <!-- =====================================================
         ABOUT
         ===================================================== -->

    <section class="settings-tab-content" data-tab-content="about">

        <div class="settings-panel settings-about-panel">

            <div class="settings-about-hero">

                <div class="settings-about-logo">
                    📅
                </div>

                <h2>
                    ScheduleSystem
                </h2>

                <p>
                    Система управления учебным расписанием
                    образовательного учреждения.
                </p>

                <span class="settings-about-version">
                    Версия 1.0
                </span>

            </div>


            <div class="settings-divider"></div>


            <!-- About -->

            <div class="settings-about-section">

                <h3>О системе</h3>

                <p>
                    ScheduleSystem предназначена для создания,
                    управления и просмотра учебного расписания.
                    Система объединяет данные о группах,
                    преподавателях, предметах и аудиториях
                    в едином интерфейсе.
                </p>

                <p>
                    Программа позволяет создавать расписание
                    вручную, проверять конфликты, учитывать
                    ограничения аудиторий, преподавателей
                    и учебных групп.
                </p>

            </div>


            <div class="settings-divider"></div>


            <!-- Features -->

            <div class="settings-about-section">

                <h3>Основные возможности</h3>

                <div class="settings-about-feature-grid">

                    <div class="settings-about-feature">

                        <span>📅</span>

                        <div>
                            <strong>Расписание</strong>
                            <p>
                                Создание, просмотр и управление
                                учебными занятиями.
                            </p>
                        </div>

                    </div>


                    <div class="settings-about-feature">

                        <span>👥</span>

                        <div>
                            <strong>Группы</strong>
                            <p>
                                Управление учебными группами
                                и их учебной нагрузкой.
                            </p>
                        </div>

                    </div>


                    <div class="settings-about-feature">

                        <span>👨‍🏫</span>

                        <div>
                            <strong>Преподаватели</strong>
                            <p>
                                Хранение информации о преподавателях
                                и их предметах.
                            </p>
                        </div>

                    </div>


                    <div class="settings-about-feature">

                        <span>🏫</span>

                        <div>
                            <strong>Аудитории</strong>
                            <p>
                                Учёт помещений и их вместимости.
                            </p>
                        </div>

                    </div>


                    <div class="settings-about-feature">

                        <span>🛡</span>

                        <div>
                            <strong>Проверка конфликтов</strong>
                            <p>
                                Контроль пересечений занятий,
                                вместимости и требований аудиторий.
                            </p>
                        </div>

                    </div>


                    <div class="settings-about-feature">

                        <span>📊</span>

                        <div>
                            <strong>Экспорт</strong>
                            <p>
                                Подготовка расписания
                                в различных форматах.
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            <div class="settings-divider"></div>


            <!-- Technologies -->

            <div class="settings-about-section">

                <h3>Технологии</h3>

                <div class="settings-tech-list">

                    <span>ASP.NET Core</span>
                    <span>C#</span>
                    <span>Entity Framework Core</span>
                    <span>PostgreSQL</span>
                    <span>HTML / CSS / JavaScript</span>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MODALS
         ===================================================== -->

    @if (isAdmin)
    {
        <!-- Clear schedule -->

        <div id="clearScheduleModal" class="settings-modal" hidden>

            <div class="settings-modal-backdrop" data-modal-close>
            </div>


            <div class="settings-modal-content" role="dialog" aria-modal="true" aria-labelledby="clearScheduleTitle">

                <button type="button" class="settings-modal-close" data-modal-close aria-label="Закрыть">

                    ×

                </button>


                <div class="settings-modal-icon">
                    ⚠
                </div>


                <h2 id="clearScheduleTitle">
                    Очистить расписание?
                </h2>


                <p>
                    Все созданные занятия будут удалены.
                    Группы, преподаватели, предметы и аудитории
                    останутся в системе.
                </p>


                <form asp-controller="Account" asp-action="ClearSchedule" method="post">

                    @Html.AntiForgeryToken()

                    <div class="settings-modal-actions">

                        <button type="button" class="settings-secondary-button" data-modal-close>

                            Отмена

                        </button>

                        <button type="submit" class="settings-danger-button">

                            Очистить расписание

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- Clear all data -->

        <div id="clearAllDataModal" class="settings-modal" hidden>

            <div class="settings-modal-backdrop" data-modal-close>
            </div>


            <div class="settings-modal-content" role="dialog" aria-modal="true" aria-labelledby="clearAllDataTitle">

                <button type="button" class="settings-modal-close" data-modal-close aria-label="Закрыть">

                    ×

                </button>


                <div class="settings-modal-icon settings-modal-icon-danger">
                    🛑
                </div>


                <h2 id="clearAllDataTitle">
                    Удалить все данные?
                </h2>


                <p>
                    Будут удалены расписание, группы,
                    преподаватели, предметы и аудитории.
                    Это действие нельзя отменить.
                </p>


                <form asp-controller="Account" asp-action="ClearAllData" method="post">

                    @Html.AntiForgeryToken()

                    <div class="settings-modal-actions">

                        <button type="button" class="settings-secondary-button" data-modal-close>

                            Отмена

                        </button>

                        <button type="submit" class="settings-danger-button">

                            Удалить всё

                        </button>

                    </div>

                </form>

            </div>

        </div>
    }

</div>


<!-- =========================================================
     SCRIPTS
     ========================================================= -->

<script src="~/js/Account/Settings.js" asp-append-version="true">
</script>