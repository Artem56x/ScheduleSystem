@{
    ViewData["Title"] = "Изменение пароля";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Account/ChangePassword.css" asp-append-version="true" />
}

<div class="change-password-page">

    <div class="change-password-container">

        <div class="change-password-header">

            <a asp-controller="Account" asp-action="Settings" class="change-password-back">
                ← Настройки профиля
            </a>

            <div class="change-password-title">

                <div class="password-main-icon">
                    🔐
                </div>

                <div>
                    <h1>Изменение пароля</h1>

                    <p>
                        Обновите пароль для защиты вашей учётной записи
                    </p>
                </div>

            </div>

        </div>

        <div class="glass-password-card">

            <div asp-validation-summary="ModelOnly" class="password-validation">
            </div>

            <form asp-controller="Account" asp-action="ChangePassword" method="post">

                @Html.AntiForgeryToken()

                <div class="password-field">

                    <label for="currentPassword">
                        Текущий пароль
                    </label>

                    <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password"
                           placeholder="Введите текущий пароль" required />

                </div>

                <div class="password-field">

                    <label for="newPassword">
                        Новый пароль
                    </label>

                    <input type="password" id="newPassword" name="newPassword" autocomplete="new-password"
                           placeholder="Введите новый пароль" minlength="6" required />

                    <span class="password-hint">
                        Минимум 6 символов
                    </span>

                </div>

                <div class="password-field">

                    <label for="confirmPassword">
                        Подтверждение нового пароля
                    </label>

                    <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password"
                           placeholder="Повторите новый пароль" minlength="6" required />

                </div>

                <div class="password-actions">

                    <a asp-controller="Account" asp-action="Settings" class="password-cancel">
                        Отмена
                    </a>

                    <button type="submit" class="password-submit">
                        Изменить пароль
                    </button>

                </div>

            </form>

        </div>

        <div class="password-security-note">

            <span class="security-note-icon">🛡️</span>

            <span>
                После изменения пароля ваша текущая сессия останется активной.
            </span>

        </div>

    </div>

</div>