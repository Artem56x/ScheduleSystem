@{
    ViewData["Title"] = "Настройки программы";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Account/ProgramSettings.css" asp-append-version="true" />
}

<div class="program-settings-page">

    <div class="program-settings-container">

        <!-- HEADER -->

        <div class="program-settings-header">

            <a asp-controller="Account" asp-action="Profile" class="program-settings-back">
                ← Профиль
            </a>

            <div class="program-settings-title-row">

                <div class="program-settings-title-icon">
                    ⚙️
                </div>

                <div>

                    <h1>
                        Настройки программы
                    </h1>

                    <p>
                        Управление параметрами и обслуживанием ScheduleSystem
                    </p>

                </div>

            </div>

        </div>


        <!-- PROGRAM MESSAGE -->

        @if (TempData["ProgramMessage"] != null)
        {
            <div class="program-success-message">

                <span class="program-success-icon">
                    ✓
                </span>

                <span>
                    @TempData["ProgramMessage"]
                </span>

            </div>
        }


        <!-- GENERAL -->

        <div class="glass-program-card">

            <div class="program-card-header">

                <div class="program-card-icon">
                    🖥️
                </div>

                <div>

                    <h2>
                        Общие настройки
                    </h2>

                    <p>
                        Основная информация о системе
                    </p>

                </div>

            </div>


            <div class="program-settings-list">

                <div class="program-setting-row">

                    <div class="program-setting-info">

                        <strong>
                            Название системы
                        </strong>

                        <span>
                            Название приложения, отображаемое в интерфейсе
                        </span>

                    </div>

                    <div class="program-setting-value">
                        ScheduleSystem
                    </div>

                </div>


                <div class="program-setting-row">

                    <div class="program-setting-info">

                        <strong>
                            Версия
                        </strong>

                        <span>
                            Текущая версия приложения
                        </span>

                    </div>

                    <div class="program-setting-value">
                        1.0
                    </div>

                </div>


                <div class="program-setting-row">

                    <div class="program-setting-info">

                        <strong>
                            Статус системы
                        </strong>

                        <span>
                            Состояние приложения
                        </span>

                    </div>

                    <div class="program-status active">

                        <span class="status-dot"></span>

                        Работает

                    </div>

                </div>

            </div>

        </div>


        <!-- APPEARANCE -->

        <div class="glass-program-card">

            <div class="program-card-header">

                <div class="program-card-icon">
                    🎨
                </div>

                <div>

                    <h2>
                        Внешний вид
                    </h2>

                    <p>
                        Управление оформлением интерфейса
                    </p>

                </div>

            </div>


            <div class="program-option">

                <div class="program-option-left">

                    <div class="program-option-icon">
                        ☀️
                    </div>

                    <div class="program-option-text">

                        <strong>
                            Тема оформления
                        </strong>

                        <span>
                            Выберите внешний вид ScheduleSystem
                        </span>

                    </div>

                </div>


                <div class="program-theme-options">

                    <button type="button" class="theme-option active">

                        ☀️

                        <span>
                            Светлая
                        </span>

                    </button>


                    <button type="button" class="theme-option disabled" disabled>

                        🌙

                        <span>
                            Тёмная
                        </span>

                        <small>
                            Скоро
                        </small>

                    </button>

                </div>

            </div>

        </div>


        <!-- SYSTEM INFORMATION -->

        <div class="glass-program-card">

            <div class="program-card-header">

                <div class="program-card-icon">
                    📊
                </div>

                <div>

                    <h2>
                        Информация о данных
                    </h2>

                    <p>
                        Сводная информация о содержимом системы
                    </p>

                </div>

            </div>


            <div class="program-stat-grid">

                <!-- TEACHERS -->

                <div class="program-stat">

                    <div class="program-stat-icon">
                        👨‍🏫
                    </div>

                    <div class="program-stat-content">

                        <span>
                            Преподаватели
                        </span>

                        <strong>
                            @ViewBag.TeacherCount
                        </strong>

                    </div>

                </div>


                <!-- GROUPS -->

                <div class="program-stat">

                    <div class="program-stat-icon">
                        👥
                    </div>

                    <div class="program-stat-content">

                        <span>
                            Группы
                        </span>

                        <strong>
                            @ViewBag.GroupCount
                        </strong>

                    </div>

                </div>


                <!-- SUBJECTS -->

                <div class="program-stat">

                    <div class="program-stat-icon">
                        📚
                    </div>

                    <div class="program-stat-content">

                        <span>
                            Предметы
                        </span>

                        <strong>
                            @ViewBag.SubjectCount
                        </strong>

                    </div>

                </div>


                <!-- CLASSROOMS -->

                <div class="program-stat">

                    <div class="program-stat-icon">
                        🏫
                    </div>

                    <div class="program-stat-content">

                        <span>
                            Аудитории
                        </span>

                        <strong>
                            @ViewBag.ClassroomCount
                        </strong>

                    </div>

                </div>


                <!-- SCHEDULES -->

                <div class="program-stat">

                    <div class="program-stat-icon">
                        📅
                    </div>

                    <div class="program-stat-content">

                        <span>
                            Занятия
                        </span>

                        <strong>
                            @ViewBag.ScheduleCount
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- MAINTENANCE -->

        <div class="glass-program-card">

            <div class="program-card-header">

                <div class="program-card-icon warning">
                    🛠️
                </div>

                <div>

                    <h2>
                        Обслуживание
                    </h2>

                    <p>
                        Управление системными данными
                    </p>

                </div>

            </div>


            <!-- CLEAR SCHEDULE -->

            <div class="program-option maintenance-option">

                <div class="program-option-left">

                    <div class="program-option-icon danger">
                        📅
                    </div>

                    <div class="program-option-text">

                        <strong>
                            Очистить расписание
                        </strong>

                        <span>
                            Удалить все записи расписания, сохранив преподавателей,
                            группы и аудитории
                        </span>

                    </div>

                </div>


                <button type="button" class="program-maintenance-button danger" onclick="openClearScheduleModal()">

                    Очистить

                </button>

            </div>


            <!-- RESET ALL DATA -->

            <div class="program-option maintenance-option danger-row">

                <div class="program-option-left">

                    <div class="program-option-icon danger">
                        ⚠️
                    </div>

                    <div class="program-option-text">

                        <strong>
                            Сбросить все данные
                        </strong>

                        <span>
                            Полностью очистить данные системы.
                            Пользователи и настройки авторизации не будут удалены.
                            Это действие невозможно отменить.
                        </span>

                    </div>

                </div>


                <button type="button" class="program-maintenance-button danger" onclick="openClearAllDataModal()">

                    Сбросить

                </button>

            </div>

        </div>


        <!-- ADMIN NOTE -->

        <div class="program-admin-note">

            <div class="admin-note-icon">
                🛡️
            </div>

            <div>

                <strong>
                    Административный раздел
                </strong>

                <span>
                    Эти настройки доступны только пользователям с ролью
                    «Администратор».
                </span>

            </div>

        </div>


        <!-- FOOTER -->

        <div class="program-settings-footer">

            <a asp-controller="Home" asp-action="Index" class="program-back-home">

                Вернуться на главную

            </a>

        </div>

    </div>

</div>


<!-- =========================================================
     CLEAR SCHEDULE MODAL
     ========================================================= -->

<div id="clearScheduleModal" class="program-modal-overlay" aria-hidden="true">

    <div class="program-modal" role="dialog" aria-modal="true" aria-labelledby="clearScheduleTitle">

        <div class="program-modal-icon danger">
            📅
        </div>


        <div class="program-modal-content">

            <h3 id="clearScheduleTitle">
                Очистить расписание?
            </h3>

            <p>
                Все записи расписания будут удалены.
                Преподаватели, группы, предметы и аудитории
                останутся без изменений.
            </p>

        </div>


        <form asp-controller="Account" asp-action="ClearSchedule" method="post" class="program-modal-actions">

            @Html.AntiForgeryToken()

            <button type="button" class="program-modal-button cancel" onclick="closeClearScheduleModal()">

                Отмена

            </button>


            <button type="submit" class="program-modal-button confirm">

                Очистить

            </button>

        </form>

    </div>

</div>


<!-- =========================================================
     CLEAR ALL DATA MODAL
     ========================================================= -->

<div id="clearAllDataModal" class="program-modal-overlay" aria-hidden="true">

    <div class="program-modal danger-modal" role="dialog" aria-modal="true" aria-labelledby="clearAllDataTitle">

        <div class="program-modal-icon danger">
            ⚠️
        </div>


        <div class="program-modal-content">

            <h3 id="clearAllDataTitle">
                Сбросить все данные?
            </h3>

            <p>
                Все данные системы будут удалены без возможности восстановления.
            </p>

            <div class="program-danger-list">

                <div>
                    <span>✓</span>
                    Преподаватели
                </div>

                <div>
                    <span>✓</span>
                    Группы
                </div>

                <div>
                    <span>✓</span>
                    Предметы
                </div>

                <div>
                    <span>✓</span>
                    Аудитории
                </div>

                <div>
                    <span>✓</span>
                    Категории аудиторий
                </div>

                <div>
                    <span>✓</span>
                    Расписание
                </div>

            </div>

            <p class="program-danger-warning">
                ⚠️ Учётные записи пользователей и роли
                <strong>не будут удалены</strong>.
            </p>

        </div>


        <form asp-controller="Account" asp-action="ClearAllData" method="post" class="program-modal-actions">

            @Html.AntiForgeryToken()

            <button type="button" class="program-modal-button cancel" onclick="closeClearAllDataModal()">

                Отмена

            </button>


            <button type="submit" class="program-modal-button confirm danger-confirm">

                Сбросить всё

            </button>

        </form>

    </div>

</div>


<script>

    /*
     * =========================================================
     * CLEAR SCHEDULE
     * =========================================================
     */

    function openClearScheduleModal() {

        const modal =
            document.getElementById("clearScheduleModal");

        if (!modal) {
            return;
        }

        modal.classList.add("show");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.classList.add(
            "modal-open"
        );

        setTimeout(function () {

            const cancelButton =
                modal.querySelector(
                    ".program-modal-button.cancel"
                );

            if (cancelButton) {
                cancelButton.focus();
            }

        }, 50);
    }


    function closeClearScheduleModal() {

        const modal =
            document.getElementById("clearScheduleModal");

        if (!modal) {
            return;
        }

        modal.classList.remove("show");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.classList.remove(
            "modal-open"
        );
    }


    /*
     * =========================================================
     * CLEAR ALL DATA
     * =========================================================
     */

    function openClearAllDataModal() {

        const modal =
            document.getElementById("clearAllDataModal");

        if (!modal) {
            return;
        }

        modal.classList.add("show");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.classList.add(
            "modal-open"
        );

        setTimeout(function () {

            const cancelButton =
                modal.querySelector(
                    ".program-modal-button.cancel"
                );

            if (cancelButton) {
                cancelButton.focus();
            }

        }, 50);
    }


    function closeClearAllDataModal() {

        const modal =
            document.getElementById("clearAllDataModal");

        if (!modal) {
            return;
        }

        modal.classList.remove("show");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.classList.remove(
            "modal-open"
        );
    }


    /*
     * =========================================================
     * DOM READY
     * =========================================================
     */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const clearScheduleModal =
                document.getElementById(
                    "clearScheduleModal"
                );

            const clearAllDataModal =
                document.getElementById(
                    "clearAllDataModal"
                );


            /*
             * Закрытие окна очистки расписания
             * при клике вне модального окна
             */

            if (clearScheduleModal) {

                clearScheduleModal.addEventListener(
                    "click",
                    function (event) {

                        if (event.target === clearScheduleModal) {

                            closeClearScheduleModal();

                        }

                    }
                );

            }


            /*
             * Закрытие окна полного сброса
             * при клике вне модального окна
             */

            if (clearAllDataModal) {

                clearAllDataModal.addEventListener(
                    "click",
                    function (event) {

                        if (event.target === clearAllDataModal) {

                            closeClearAllDataModal();

                        }

                    }
                );

            }


            /*
             * Закрытие обоих окон по Escape
             */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key !== "Escape") {
                        return;
                    }


                    if (
                        clearScheduleModal &&
                        clearScheduleModal.classList.contains("show")
                    ) {

                        closeClearScheduleModal();

                    }


                    if (
                        clearAllDataModal &&
                        clearAllDataModal.classList.contains("show")
                    ) {

                        closeClearAllDataModal();

                    }

                }
            );

        }
    );

</script>