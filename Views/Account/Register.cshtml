@{
    ViewData["Title"] = "Регистрация";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">

            <h1>Регистрация</h1>

            <p>Создайте аккаунт в ScheduleSystem</p>

        </div>

        <form asp-action="Register" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-message">
            </div>

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <div class="input-wrapper">

                    <span class="input-icon">@@</span>

                    <input type="email" id="email" name="email" placeholder="Введите email" autocomplete="email"
                           required />

                </div>

            </div>

            <div class="form-group">

                <label for="password">
                    Пароль
                </label>

                <div class="input-wrapper">

                    <span class="input-icon">•</span>

                    <input type="password" id="password" name="password" placeholder="Минимум 6 символов"
                           autocomplete="new-password" required />

                    <button type="button" class="password-toggle ui-button ui-icon-button" id="passwordToggle" aria-label="Показать пароль" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>

                </div>

            </div>

            <div class="form-group">

                <label for="confirmPassword">
                    Подтверждение пароля
                </label>

                <div class="input-wrapper">

                    <span class="input-icon">•</span>

                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Повторите пароль"
                           autocomplete="new-password" required />

                    <button type="button" class="password-toggle ui-button ui-icon-button" id="confirmPasswordToggle"
                            aria-label="Показать пароль" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>

                </div>

            </div>

            <button type="submit" class="login-button ui-button ui-primary">

                <span>Зарегистрироваться</span>

                <span class="login-button-arrow"><i class="bi bi-arrow-right" aria-hidden="true"></i></span>

            </button>

            <div class="account-register">

                <span>Уже есть аккаунт?</span>

                <a asp-action="Login">
                    Войти
                </a>

            </div>

        </form>

    </div>

</div>

@section Styles {

    <link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

}

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function setupPasswordToggle(inputId, toggleId) {

                const input =
                    document.getElementById(inputId);

                const toggle =
                    document.getElementById(toggleId);

                if (!input || !toggle) {
                    return;
                }

                toggle.addEventListener("click", function () {

                    const isPassword =
                        input.type === "password";

                    input.type =
                        isPassword
                            ? "text"
                            : "password";

                    toggle.innerHTML = isPassword
                    ? '<i class="bi bi-eye-slash" aria-hidden="true"></i>'
                    : '<i class="bi bi-eye" aria-hidden="true"></i>';
                toggle.setAttribute("aria-pressed", String(isPassword));

                    toggle.setAttribute(
                        "aria-label",
                        isPassword
                            ? "Скрыть пароль"
                            : "Показать пароль"
                    );

                });

            }

            setupPasswordToggle(
                "password",
                "passwordToggle"
            );

            setupPasswordToggle(
                "confirmPassword",
                "confirmPasswordToggle"
            );

        });
    </script>

}
