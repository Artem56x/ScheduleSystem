        border: 1px solid rgba(255, 255, 255, 0.9);
        font-size: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
    }


    .lesson-label {
        display: block;
        margin-bottom: 6px;
        font-size: 10px;
