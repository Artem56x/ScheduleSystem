    }


    @@media (max-width: 800px) {

        .details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-actions {
            width: 100%;
        }

        .header-actions .glass-button {
            flex: 1;
        }

        .lesson-info-grid {
            grid-template-columns: 1fr;
        }

        .summary-section {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }


    @@media (max-width: 600px) {

        .schedule-details-page {
            padding: 20px 14px 40px;
        }

        .lesson-main-card {
            padding: 20px;
            border-radius: 22px;
        }

        .details-header h1 {
            font-size: 29px;
        }

        .lesson-title-block h2 {
            font-size: 23px;
        }

        .lesson-card-top {
            align-items: flex-start;
        }

        .time-display {
            flex-direction: column;
            gap: 10px;
        }

        .time-box {
            width: 100%;
        }

        .time-line {
            transform: rotate(90deg);
        }

        .summary-section {
            grid-template-columns: 1fr;
        }

        .details-footer {
            flex-direction: column;
        }

        .details-footer .footer-button {
            width: 100%;
        }

    }
</style>