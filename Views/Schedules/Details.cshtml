    }


    .time-line div {
        flex: 1;
        height: 1px;
        background: rgba(0, 0, 0, 0.2);
    }


    .summary-section {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-top: 24px;
    }


    .summary-item {
        padding: 16px;
        border-radius: 17px;
