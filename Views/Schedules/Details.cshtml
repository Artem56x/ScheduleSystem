        color: #222;
    }


    .details-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid rgba(0, 0, 0, 0.07);
    }


    .footer-button {
        display: inline-flex;
        align-items: center;
