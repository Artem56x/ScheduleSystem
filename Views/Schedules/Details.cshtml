@model ScheduleSystem.Models.Schedule

@{
    ViewData["Title"] = "Детали занятия";


    var dayNames = new Dictionary<DayOfWeek, string>
{
    { DayOfWeek.Monday, "Понедельник" },
    { DayOfWeek.Tuesday, "Вторник" },
    { DayOfWeek.Wednesday, "Среда" },
    { DayOfWeek.Thursday, "Четверг" },
    { DayOfWeek.Friday, "Пятница" },
    { DayOfWeek.Saturday, "Суббота" },
    { DayOfWeek.Sunday, "Воскресенье" }
};

    string dayName = "День не указан";

    if (Model.DayOfWeek.HasValue)
    {
        var selectedDay = Model.DayOfWeek.Value;

        if (dayNames.ContainsKey(selectedDay))
        {
            dayName = dayNames[selectedDay];
        }
    }

    string startTime = "--:--";
    string endTime = "--:--";

    if (Model.StartTime.HasValue)
    {
        startTime = Model.StartTime.Value.ToString(@"hh\:mm");
    }

    if (Model.EndTime.HasValue)
    {
        endTime = Model.EndTime.Value.ToString(@"hh\:mm");
    }


}

@section Styles {
    <link rel="stylesheet" href="~/css/Schedules/Details.css" asp-append-version="true" />
}

<div class="schedule-details-page ui-form-layout">


    <div class="details-header ui-page-heading">
        <div>
            <div class="details-badge">РАСПИСАНИЕ</div>

            <h1>Детали занятия</h1>

            <p>
                Подробная информация о занятии в расписании
            </p>
        </div>

        <div class="header-actions">

            <a asp-action="Index" class="glass-button ui-button secondary-button">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Назад
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="glass-button ui-button ui-primary primary-button">
                    ✎ Редактировать
                </a>
            }

        </div>
    </div>


    <div class="lesson-main-card ui-surface ui-panel">

        <div class="lesson-card-top">

            <div class="lesson-icon">
                <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
            </div>

            <div class="lesson-title-block">

                <span class="lesson-label">
                    ПРЕДМЕТ
                </span>

                <h2>
                    @(Model.Subject?.Name ?? "Предмет не указан")
                </h2>

                <p>
                    @dayName
                </p>

            </div>

        </div>


        <div class="lesson-info-grid">

            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                </div>

                <div class="info-content">

                    <span class="info-label">
                        Преподаватель
                    </span>

                    <strong>
                        @(Model.Teacher?.FullName ?? "Не указан")
                    </strong>

                </div>

            </div>


            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-people" aria-hidden="true"></i>
                </div>

                <div class="info-content">

                    <span class="info-label">
                        Группа
                    </span>

                    <strong>
                        @(Model.Group?.Name ?? "Не указана")
                    </strong>

                </div>

            </div>


            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-door-open" aria-hidden="true"></i>
                </div>

                <div class="info-content">

                    <span class="info-label">
                        Аудитория
                    </span>

                    <strong>
                        @(Model.Classroom?.Name ?? "Не указана")
                    </strong>

                </div>

            </div>


            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-calendar-week" aria-hidden="true"></i>
                </div>

                <div class="info-content">

                    <span class="info-label">
                        День недели
                    </span>

                    <strong>
                        @dayName
                    </strong>

                </div>

            </div>

        </div>


        <div class="time-section">

            <div class="time-header">

                <div>
                    <span class="info-label">
                        ВРЕМЯ ЗАНЯТИЯ
                    </span>

                    <h3>
                        Время проведения
                    </h3>
                </div>

                <div class="clock-icon">
                    <i class="bi bi-clock" aria-hidden="true"></i>
                </div>

            </div>


            <div class="time-display">

                <div class="time-box">

                    <span>
                        НАЧАЛО
                    </span>

                    <strong>
                        @startTime
                    </strong>

                </div>


                <div class="time-line">
                    <span></span>
                    <div></div>
                    <span></span>
                </div>


                <div class="time-box">

                    <span>
                        ОКОНЧАНИЕ
                    </span>

                    <strong>
                        @endTime
                    </strong>

                </div>

            </div>

        </div>

        <div class="details-footer">

            <a asp-action="Index" class="footer-button ui-button secondary-button">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Вернуться к расписанию
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="footer-button ui-button ui-primary primary-button">
                    ✎ Изменить занятие
                </a>
            }

        </div>

    </div>

</div>
