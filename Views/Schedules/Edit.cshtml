@model ScheduleSystem.Models.Schedule

@{
    ViewData["Title"] = "Редактировать занятие";

    /* =========================================================
       ПРЕПОДАВАТЕЛЬ
       ========================================================= */

    bool showTeacherWarning =
        ViewBag.TeacherSubjectWarning == true;

    var recommendedTeachers =
        ViewBag.RecommendedTeachers
        as List<ScheduleSystem.Models.Teacher>;

    bool hasTeacherConflict =
        ViewBag.TeacherConflict == true;

    bool showTeacherRecommendations =
        hasTeacherConflict &&
        recommendedTeachers != null &&
        recommendedTeachers.Any();

    bool showTeacherConflictWithoutRecommendations =
        hasTeacherConflict &&
        (recommendedTeachers == null ||
         !recommendedTeachers.Any());


    /* =========================================================
       АУДИТОРИИ
       ========================================================= */

    var recommendedClassrooms =
        ViewBag.RecommendedClassrooms
        as List<ScheduleSystem.Models.Classroom>;

    bool showClassroomRecommendations =
        recommendedClassrooms != null &&
        recommendedClassrooms.Any();

    bool showNoClassroomRecommendations =
        recommendedClassrooms != null &&
        !recommendedClassrooms.Any();


    /* =========================================================
       ОБЩИЕ ОШИБКИ ВАЛИДАЦИИ
       ========================================================= */

    var validationErrors = ViewData.ModelState
        .Where(x => x.Value != null)
        .SelectMany(x => x.Value!.Errors)
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();

    bool showValidationModal =
        validationErrors.Any() &&
        !hasTeacherConflict;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Schedules/Edit.css"
          asp-append-version="true" />
}


<div class="schedule-create-page ui-form-layout">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="create-header ui-page-heading">

        <div>

            <div class="create-badge">
                РАСПИСАНИЕ
            </div>

            <h1>
                Редактировать занятие
            </h1>

            <p>
                Изменение информации о занятии
            </p>

        </div>

        <div class="header-actions">

            <a asp-action="Index"
               class="glass-button ui-button secondary-button">

                <i class="bi bi-arrow-left" aria-hidden="true"></i> Назад

            </a>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- MAIN CARD -->
    <!-- ================================================= -->

    <div class="create-main-card ui-surface ui-panel">

        <!-- CARD TOP -->

        <div class="create-card-top">

            <div class="create-icon">
                <i class="bi bi-pencil" aria-hidden="true"></i>
            </div>

            <div class="create-title-block">

                <span class="create-label">
                    РЕДАКТИРОВАНИЕ
                </span>

                <h2>
                    Информация о занятии
                </h2>

                <p>
                    Измените необходимые данные расписания.
                </p>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- FORM -->
        <!-- ================================================= -->

        <form asp-action="Edit"
              method="post"
              id="scheduleForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <input type="hidden"
                   name="confirmTeacherSubject"
                   id="confirmTeacherSubject"
                   value="false" />


            <div asp-validation-summary="ModelOnly"
                 class="glass-validation">
            </div>


            <!-- ================================================= -->
            <!-- ОСНОВНАЯ ИНФОРМАЦИЯ -->
            <!-- ================================================= -->

            <div class="form-section">

                <div class="form-section-title">
                    Основная информация
                </div>


                <div class="form-grid">

                    <!-- ПРЕПОДАВАТЕЛЬ -->

                    <div class="form-group">

                        <label asp-for="TeacherId"
                               class="form-label">

                            Преподаватель

                        </label>

                        <select asp-for="TeacherId"
                                class="form-control glass-input"
                                asp-items="ViewBag.TeacherId">

                            <option value="">
                                Выберите преподавателя
                            </option>

                        </select>

                        <span asp-validation-for="TeacherId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ПРЕДМЕТ -->

                    <div class="form-group">

                        <label asp-for="SubjectId"
                               class="form-label">

                            Предмет

                        </label>

                        <select asp-for="SubjectId"
                                class="form-control glass-input"
                                asp-items="ViewBag.SubjectId">

                            <option value="">
                                Выберите предмет
                            </option>

                        </select>

                        <span asp-validation-for="SubjectId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ГРУППА -->

                    <div class="form-group">

                        <label asp-for="GroupId"
                               class="form-label">

                            Группа

                        </label>

                        <select asp-for="GroupId"
                                class="form-control glass-input"
                                asp-items="ViewBag.GroupId">

                            <option value="">
                                Выберите группу
                            </option>

                        </select>

                        <span asp-validation-for="GroupId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- АУДИТОРИЯ -->

                    <div class="form-group">

                        <label asp-for="ClassroomId"
                               class="form-label">

                            Аудитория

                        </label>

                        <select asp-for="ClassroomId"
                                class="form-control glass-input"
                                asp-items="ViewBag.ClassroomId">

                            <option value="">
                                Выберите аудиторию
                            </option>

                        </select>

                        <span asp-validation-for="ClassroomId"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ВРЕМЯ -->
            <!-- ================================================= -->

            <div class="form-section">

                <div class="form-section-title">
                    Время занятия
                </div>


                <!-- ДЕНЬ НЕДЕЛИ -->

                <div class="form-group">

                    <label asp-for="DayOfWeek"
                           class="form-label">

                        День недели

                    </label>

                    <select asp-for="DayOfWeek"
                            class="form-control glass-input"
                            asp-items="ViewBag.DayOfWeek">

                        <option value="">
                            Выберите день недели
                        </option>

                    </select>

                    <span asp-validation-for="DayOfWeek"
                          class="text-danger">
                    </span>

                </div>


                <!-- ВРЕМЯ -->

                <div class="time-row">

                    <!-- НАЧАЛО -->

                    <div class="form-group">

                        <label asp-for="StartTime"
                               class="form-label">

                            Время начала

                        </label>

                        <div class="time-input-wrapper">

                            <span class="time-input-icon">
                                <i class="bi bi-clock" aria-hidden="true"></i>
                            </span>

                            <input asp-for="StartTime"
                                   type="time"
                                   class="form-control glass-input" />

                        </div>

                        <span asp-validation-for="StartTime"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ОКОНЧАНИЕ -->

                    <div class="form-group">

                        <label asp-for="EndTime"
                               class="form-label">

                            Время окончания

                        </label>

                        <div class="time-input-wrapper">

                            <span class="time-input-icon">
                                <i class="bi bi-clock" aria-hidden="true"></i>
                            </span>

                            <input asp-for="EndTime"
                                   type="time"
                                   class="form-control glass-input" />

                        </div>

                        <span asp-validation-for="EndTime"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ACTIONS -->
            <!-- ================================================= -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="footer-button ui-button secondary-button">

                    Отмена

                </a>


                <button type="submit"
                        class="footer-button ui-button ui-primary primary-button">

                    <span><i class="bi bi-check2" aria-hidden="true"></i></span>

                    Сохранить изменения

                </button>

            </div>

        </form>

    </div>

</div>


<!-- ===================================================== -->
<!-- ПРЕДУПРЕЖДЕНИЕ ПРЕПОДАВАТЕЛЯ / ПРЕДМЕТА -->
<!-- ===================================================== -->

@if (showTeacherWarning)
{
    <div class="warning-overlay"
         id="teacherWarning">

        <div class="warning-modal">

            <div class="warning-icon">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            </div>

            <h2>
                Проверьте преподавателя
            </h2>

            <p>
                Преподаватель

                <strong>
                    @ViewBag.TeacherName
                </strong>

                обычно ведёт предмет

                <strong>
                    «@ViewBag.TeacherSubjectName»
                </strong>.
            </p>

            <p>
                Сейчас выбран предмет

                <strong>
                    «@ViewBag.SelectedSubjectName»
                </strong>.
            </p>

            <p class="warning-question">
                Вы точно хотите оставить этого преподавателя?
            </p>


            <div class="warning-actions">

                <button type="button"
                        class="warning-cancel ui-button"
                        onclick="closeTeacherWarning()">

                    Вернуться

                </button>


                <button type="button"
                        class="warning-confirm ui-button ui-primary"
                        onclick="confirmTeacher()">

                    Да, оставить

                </button>

            </div>

        </div>

    </div>
}


<!-- ===================================================== -->
<!-- РЕКОМЕНДАЦИИ ПРЕПОДАВАТЕЛЕЙ -->
<!-- ===================================================== -->

@if (showTeacherRecommendations)
{
    <div class="warning-overlay"
         id="teacherRecommendationModal">

        <div class="teacher-recommendation-modal">

            <div class="teacher-recommendation-icon">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
            </div>

            <h2>
                Преподаватель уже занят
            </h2>

            <p class="teacher-recommendation-description">

                Преподаватель

                <strong>
                    «@ViewBag.SelectedTeacherName»
                </strong>

                занят в выбранное время.

            </p>


            @if (!string.IsNullOrWhiteSpace(
                ViewBag.TeacherProblem as string))
            {
                <div class="teacher-problem">
                    @ViewBag.TeacherProblem
                </div>
            }


            <p class="teacher-recommendation-subtitle">
                Подходящие свободные преподаватели:
            </p>


            <div class="recommended-teacher-list">

                @foreach (var teacher in recommendedTeachers!)
                {
                    <div class="recommended-teacher">

                        <div class="recommended-teacher-info">

                            <div class="recommended-teacher-name">
                                @teacher.FullName
                            </div>

                            <div class="recommended-teacher-details">

<span>
    <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
    @if (teacher.TeacherSubjects != null &&
         teacher.TeacherSubjects.Any())
    {
        @string.Join(
            ", ",
            teacher.TeacherSubjects
                .Where(ts => ts.Subject != null)
                .OrderBy(ts => ts.Subject!.Name)
                .Select(ts => ts.Subject!.Name)
        )
    }
    else
    {
        <text>Предметы не указаны</text>
    }
</span>

                                <span>
                                    <i class="bi bi-check2" aria-hidden="true"></i> Свободен
                                </span>

                                <span>
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                    @Model.StartTime?.ToString(@"hh\:mm")
                                    –
                                    @Model.EndTime?.ToString(@"hh\:mm")
                                </span>

                            </div>

                        </div>


                        <button type="button"
                                class="select-teacher-button ui-button ui-primary"
                                onclick="selectTeacher(@teacher.Id)">

                            Выбрать

                        </button>

                    </div>
                }

            </div>


            <div class="teacher-recommendation-actions">

                <button type="button"
                        class="warning-cancel ui-button"
                        onclick="closeTeacherRecommendations()">

                    Оставить выбранного

                </button>

            </div>

        </div>

    </div>
}


<!-- ===================================================== -->
<!-- КОНФЛИКТ ПРЕПОДАВАТЕЛЯ БЕЗ РЕКОМЕНДАЦИЙ -->
<!-- ===================================================== -->

@if (showTeacherConflictWithoutRecommendations)
{
    <div class="warning-overlay"
         id="teacherConflictModal">

        <div class="teacher-recommendation-modal">

            <div class="teacher-recommendation-icon">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
            </div>

            <h2>
                Преподаватель уже занят
            </h2>


            <p class="teacher-recommendation-description">

                Преподаватель

                <strong>
                    «@ViewBag.SelectedTeacherName»
                </strong>

                уже занят в выбранное время.

            </p>


            @if (!string.IsNullOrWhiteSpace(
                ViewBag.TeacherProblem as string))
            {
                <div class="teacher-problem">
                    @ViewBag.TeacherProblem
                </div>
            }


            <p class="teacher-recommendation-subtitle">

                Свободных преподавателей для предмета
                на это время не найдено.

            </p>


            <div class="teacher-recommendation-actions">

                <button type="button"
                        class="warning-cancel ui-button"
                        onclick="closeTeacherConflict()">

                    Вернуться к редактированию

                </button>

            </div>

        </div>

    </div>
}


<!-- ===================================================== -->
<!-- РЕКОМЕНДАЦИИ АУДИТОРИЙ -->
<!-- ===================================================== -->

@if (showClassroomRecommendations)
{
    <div class="warning-overlay"
         id="classroomRecommendationModal">

        <div class="classroom-recommendation-modal">

            <div class="classroom-recommendation-icon">
                <i class="bi bi-lightbulb" aria-hidden="true"></i>
            </div>


            <h2>
                Рекомендуем другую аудиторию
            </h2>


            <p class="classroom-recommendation-description">

                Аудитория

                <strong>
                    «@ViewBag.SelectedClassroomName»
                </strong>

                не подходит для этого занятия.

            </p>


            <p class="classroom-recommendation-subtitle">
                Подходящие свободные аудитории:
            </p>


            <div class="recommended-classroom-list">

                @for (int i = 0;
                      i < recommendedClassrooms!.Count;
                      i++)
                {
                    var classroom =
                        recommendedClassrooms[i];

                    bool isOptimal = i == 0;


                    <div class="recommended-classroom @(isOptimal ? "recommended-optimal" : "")">

                        <div class="recommended-classroom-info">

                            <div class="recommended-classroom-name-row">

                                <span class="recommended-classroom-name">
                                    @classroom.Name
                                </span>


                                @if (isOptimal)
                                {
                                    <span class="optimal-badge">
                                        Оптимальный
                                    </span>
                                }

                            </div>


                            <div class="recommended-classroom-details">

                                <span>
                                    <i class="bi bi-grid" aria-hidden="true"></i> @classroom.Capacity мест
                                </span>

                            </div>

                        </div>


                        <button type="button"
                                class="select-classroom-button ui-button ui-primary"
                                onclick="selectClassroom(@classroom.Id)">

                            Выбрать

                        </button>

                    </div>
                }

            </div>


            <div class="classroom-recommendation-actions">

                <button type="button"
                        class="warning-cancel ui-button"
                        onclick="closeClassroomRecommendations()">

                    Вернуться

                </button>

            </div>

        </div>

    </div>
}


<!-- ===================================================== -->
<!-- НЕТ РЕКОМЕНДАЦИЙ АУДИТОРИЙ -->
<!-- ===================================================== -->

@if (showNoClassroomRecommendations)
{
    <div class="warning-overlay"
         id="classroomNoRecommendationModal">

        <div class="warning-modal">

            <div class="warning-icon">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            </div>


            <h2>
                Подходящих аудиторий нет
            </h2>


            <p>
                Сейчас нет свободной аудитории,
                которая подходит по вместимости
                и требованиям предмета.
            </p>


            <div class="warning-actions">

                <button type="button"
                        class="warning-cancel ui-button"
                        onclick="closeNoClassroomRecommendations()">

                    Вернуться

                </button>

            </div>

        </div>

    </div>
}


<!-- ===================================================== -->
<!-- ОБЩАЯ ВАЛИДАЦИЯ -->
<!-- ===================================================== -->

@if (showValidationModal)
{
    <div class="warning-overlay"
         id="validationErrorModal">

        <div class="warning-modal validation-error-modal">

            <div class="warning-icon">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            </div>


            <h2>
                Не удалось сохранить изменения
            </h2>


            <div class="validation-error-list">

                @foreach (var error in validationErrors)
                {
                    <div class="validation-error-item">
                        • @error
                    </div>
                }

            </div>


            <div class="warning-actions">

                <button type="button"
                        class="warning-cancel ui-button"
                        onclick="closeValidationError()">

                    Вернуться

                </button>

            </div>

        </div>

    </div>
}


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

    <script src="~/js/Schedules/Edit.js"
            asp-append-version="true"></script>
}
