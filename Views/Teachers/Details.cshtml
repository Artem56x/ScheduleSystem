@model ScheduleSystem.Models.Teacher

@{
    ViewData["Title"] = "Информация о преподавателе";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Teachers/Details.css" asp-append-version="true" />
}

<div class="schedule-details-page ui-form-layout">

    <!-- HEADER -->
    <div class="details-header ui-page-heading">

        <div>

            <span class="page-badge">
                ПРЕПОДАВАТЕЛИ
            </span>

            <h1>
                Информация о преподавателе
            </h1>

            <p>
                Подробная информация о преподавателе
            </p>

        </div>

        <div class="details-actions">

            <a asp-action="Index" class="glass-button ui-button secondary-button">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Назад
            </a>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="lesson-main-card ui-surface ui-panel">

        <!-- PROFILE -->
        <div class="teacher-profile">

            <div class="teacher-avatar">

                @if (!string.IsNullOrWhiteSpace(Model.FullName))
                {
                    @Model.FullName.Substring(0, 1).ToUpper()
                }
                else
                {
                    <span>?</span>
                }

            </div>


            <div class="teacher-main-info">

                <span class="lesson-label">
                    ПРЕПОДАВАТЕЛЬ
                </span>

                <h2>
                    @Model.FullName
                </h2>

                @if (Model.TeacherSubjects != null &&
                     Model.TeacherSubjects.Any())
                {
                    <div class="teacher-subjects-list">

                        @foreach (var teacherSubject in Model.TeacherSubjects
                            .Where(ts => ts.Subject != null)
                            .OrderBy(ts => ts.Subject!.Name))
                        {
                            <span class="subject-badge">
                                <i class="bi bi-journal-bookmark" aria-hidden="true"></i> @teacherSubject.Subject!.Name
                            </span>
                        }

                    </div>
                }
                else
                {
                    <span class="subject-badge">
                        Предметы не указаны
                    </span>
                }

            </div>

        </div>


        <!-- INFORMATION -->
        <div class="lesson-info-grid">

            <!-- ФИО -->
            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-person" aria-hidden="true"></i>
                </div>

                <div class="info-content">

                    <span class="info-label">
                        ФИО
                    </span>

                    <strong>
                        @Model.FullName
                    </strong>

                    <small>
                        Имя преподавателя
                    </small>

                </div>

            </div>


            <!-- SUBJECTS -->
            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                </div>

                <div class="info-content">

                    <span class="info-label">
                        Предметы
                    </span>

                    @if (Model.TeacherSubjects != null &&
                         Model.TeacherSubjects.Any())
                    {
                        <div class="teacher-subjects-list">

                            @foreach (var teacherSubject in Model.TeacherSubjects
                                .Where(ts => ts.Subject != null)
                                .OrderBy(ts => ts.Subject!.Name))
                            {
                                <strong class="subject-value">
                                    @teacherSubject.Subject!.Name
                                </strong>
                            }

                        </div>
                    }
                    else
                    {
                        <strong class="empty-value">
                            Не указаны
                        </strong>
                    }

                    <small>
                        Предметы, которые преподаёт сотрудник
                    </small>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="details-footer">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="glass-button ui-button ui-primary primary-button">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Изменить
                </a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="glass-button ui-button ui-danger-outline delete-button">
                    <i class="bi bi-trash" aria-hidden="true"></i> Удалить
                </a>
            }

            <a asp-action="Index" class="glass-button ui-button secondary-button">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Назад
            </a>

        </div>

    </div>

</div>
