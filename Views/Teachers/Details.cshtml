@model ScheduleSystem.Models.Teacher

@{
    ViewData["Title"] = "Информация о преподавателе";
}

<div class="schedule-details-page">

    <!-- HEADER -->
    <div class="details-header">

        <div>

            <span class="page-badge">
                ПРЕПОДАВАТЕЛИ
            </span>

            <h1>
                Информация о преподавателе
            </h1>

            <p>
                Подробная информация о преподавателе
            </p>

        </div>

        <div class="details-actions">

            <a asp-action="Index" class="glass-button secondary-button">
                ← Назад
            </a>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="lesson-main-card">

        <!-- PROFILE -->
        <div class="teacher-profile">

            <div class="teacher-avatar">

                @if (!string.IsNullOrWhiteSpace(Model.FullName))
                {
                    @Model.FullName.Substring(0, 1).ToUpper()
                }
                else
                {
                    <span>?</span>
                }

            </div>


            <div class="teacher-main-info">

                <span class="lesson-label">
                    ПРЕПОДАВАТЕЛЬ
                </span>

                <h2>
                    @Model.FullName
                </h2>

                @if (Model.Subject != null)
                {
                    <span class="subject-badge">
                        📚 @Model.Subject.Name
                    </span>
                }
                else
                {
                    <span class="subject-badge">
                        Преподаватель
                    </span>
                }

            </div>

        </div>


        <!-- INFORMATION -->
        <div class="lesson-info-grid">

            <!-- ФИО -->
            <div class="info-card">

                <div class="info-icon">
                    👤
                </div>

                <div class="info-content">

                    <span class="info-label">
                        ФИО
                    </span>

                    <strong>
                        @Model.FullName
                    </strong>

                    <small>
                        Имя преподавателя
                    </small>

                </div>

            </div>


            <!-- SUBJECT -->
            <div class="info-card">

                <div class="info-icon">
                    📚
                </div>

                <div class="info-content">

                    <span class="info-label">
                        Предмет
                    </span>

                    @if (Model.Subject != null)
                    {
                        <strong>
                            @Model.Subject.Name
                        </strong>
                    }
                    else
                    {
                        <strong class="empty-value">
                            Не указан
                        </strong>
                    }

                    <small>
                        Основной предмет
                    </small>

                </div>

            </div>


            <!-- EMAIL -->
            <div class="info-card">

                <div class="info-icon">
                    ✉️
                </div>

                <div class="info-content">

                    <span class="info-label">
                        Email
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <strong>
                            @Model.Email
                        </strong>
                    }
                    else
                    {
                        <strong class="empty-value">
                            Не указан
                        </strong>
                    }

                    <small>
                        Электронная почта
                    </small>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="details-footer">

            <a asp-action="Edit" asp-route-id="@Model.Id" class="glass-button primary-button">
                ✏️ Изменить
            </a>

            <a asp-action="Delete" asp-route-id="@Model.Id" class="glass-button delete-button">
                🗑 Удалить
            </a>

            <a asp-action="Index" class="glass-button secondary-button">
                ← Назад
            </a>

        </div>

    </div>

</div>


<style>
    /* PAGE */

    .schedule-details-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 20px 60px;
    }


    /* HEADER */

    .details-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 25px;
    }

    .page-badge {
        display: inline-flex;

        align-items: center;

        padding: 6px 11px;

        margin-bottom: 10px;

        border-radius: 999px;

        background: rgba(0, 122, 255, 0.09);

        color: #007aff;

        font-size: 0.72rem;
        font-weight: 700;

        letter-spacing: 0.08em;
    }

    .details-header h1 {
        margin: 0 0 6px;

        font-size: 2.15rem;
        font-weight: 750;

        letter-spacing: -0.7px;
    }

    .details-header p {
        margin: 0;

        color: #777;

        font-size: 0.95rem;
    }


    /* BUTTONS */

    .details-actions {
        display: flex;

        gap: 10px;
    }

    .glass-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        min-height: 44px;

        padding: 10px 17px;

        border-radius: 13px;

        text-decoration: none;

        font-size: 0.92rem;
        font-weight: 600;

        transition: 0.2s ease;

        cursor: pointer;
    }

    .secondary-button {
        border: 1px solid rgba(255, 255, 255, 0.8);

        background: rgba(255, 255, 255, 0.55);

        color: #555;

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        box-shadow:
            0 5px 15px rgba(0, 0, 0, 0.04),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .secondary-button:hover {
        background: rgba(255, 255, 255, 0.85);

        color: #222;

        transform: translateY(-1px);
    }

    .primary-button {
        border: none;

        background: linear-gradient(135deg,
                #007aff,
                #5856d6);

        color: white;

        box-shadow:
            0 8px 20px rgba(0, 122, 255, 0.18);
    }

    .primary-button:hover {
        color: white;

        transform: translateY(-1px);

        box-shadow:
            0 10px 25px rgba(0, 122, 255, 0.26);
    }

    .delete-button {
        border: 1px solid rgba(255, 59, 48, 0.15);

        background: rgba(255, 59, 48, 0.07);

        color: #dc3545;
    }

    .delete-button:hover {
        background: rgba(255, 59, 48, 0.13);

        color: #c62828;

        transform: translateY(-1px);
    }


    /* MAIN CARD */

    .lesson-main-card {
        padding: 32px;

        border: 1px solid rgba(255, 255, 255, 0.7);

        border-radius: 28px;

        background: rgba(255, 255, 255, 0.48);

        backdrop-filter: blur(25px) saturate(160%);
        -webkit-backdrop-filter: blur(25px) saturate(160%);

        box-shadow:
            0 18px 50px rgba(0, 0, 0, 0.07),
            inset 0 1px 0 rgba(255, 255, 255, 0.85);
    }


    /* PROFILE */

    .teacher-profile {
        display: flex;

        align-items: center;

        gap: 18px;

        padding-bottom: 28px;

        margin-bottom: 25px;

        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .teacher-avatar {
        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        width: 72px;
        height: 72px;

        border-radius: 22px;

        background: linear-gradient(135deg,
                #007aff,
                #5856d6);

        color: white;

        font-size: 28px;
        font-weight: 700;

        box-shadow:
            0 10px 25px rgba(0, 122, 255, 0.22);
    }

    .teacher-main-info {
        min-width: 0;
    }

    .lesson-label {
        display: block;

        margin-bottom: 5px;

        color: #007aff;

        font-size: 0.72rem;
        font-weight: 700;

        letter-spacing: 0.08em;
    }

    .teacher-main-info h2 {
        margin: 0 0 8px;

        color: #171717;

        font-size: 1.45rem;
        font-weight: 700;

        letter-spacing: -0.3px;
    }

    .subject-badge {
        display: inline-flex;

        align-items: center;

        padding: 6px 11px;

        border-radius: 10px;

        background: rgba(88, 86, 214, 0.09);

        color: #5856d6;

        font-size: 0.8rem;
        font-weight: 600;
    }


    /* INFORMATION */

    .lesson-info-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 14px;
    }

    .info-card {
        display: flex;

        align-items: flex-start;

        gap: 14px;

        padding: 17px;

        border: 1px solid rgba(255, 255, 255, 0.7);

        border-radius: 18px;

        background: rgba(255, 255, 255, 0.38);

        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .info-icon {
        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        width: 42px;
        height: 42px;

        border-radius: 13px;

        background: rgba(0, 122, 255, 0.09);

        font-size: 19px;
    }

    .info-content {
        flex: 1;

        min-width: 0;
    }

    .info-label {
        display: block;

        margin-bottom: 5px;

        color: #777;

        font-size: 0.72rem;
        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: 0.05em;
    }

    .info-content strong {
        display: block;

        color: #222;

        font-size: 0.95rem;
        font-weight: 650;

        word-break: break-word;
    }

    .info-content small {
        display: block;

        margin-top: 4px;

        color: #999;

        font-size: 0.76rem;
    }

    .empty-value {
        color: #999 !important;

        font-weight: 400 !important;
    }


    /* FOOTER */

    .details-footer {
        display: flex;

        align-items: center;

        gap: 10px;

        margin-top: 25px;

        padding-top: 22px;

        border-top: 1px solid rgba(0, 0, 0, 0.06);
    }


    /* MOBILE */

    @@media (max-width: 800px) {

        .schedule-details-page {
            padding: 25px 16px 45px;
        }

        .details-header {
            align-items: flex-start;

            flex-direction: column;
        }

        .details-actions,
        .details-actions .glass-button {
            width: 100%;
        }

        .lesson-main-card {
            padding: 25px;

            border-radius: 24px;
        }

        .lesson-info-grid {
            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 600px) {

        .schedule-details-page {
            padding: 20px 12px 40px;
        }

        .details-header h1 {
            font-size: 1.7rem;
        }

        .lesson-main-card {
            padding: 20px;

            border-radius: 20px;
        }

        .teacher-profile {
            align-items: flex-start;
        }

        .teacher-avatar {
            width: 60px;
            height: 60px;

            border-radius: 18px;

            font-size: 24px;
        }

        .teacher-main-info h2 {
            font-size: 1.2rem;
        }

        .details-footer {
            flex-direction: column;
        }

        .details-footer .glass-button {
            width: 100%;
        }

    }


    @@media (prefers-reduced-motion: reduce) {

        .glass-button {
            transition: none;
        }

    }
</style>

