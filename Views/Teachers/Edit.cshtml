@model ScheduleSystem.Models.Teacher

@{
    ViewData["Title"] = "Изменить преподавателя";

    var subjects = ViewBag.Subjects
        as IEnumerable<ScheduleSystem.ViewModels.SubjectSelectionViewModel>
        ?? Enumerable.Empty<ScheduleSystem.ViewModels.SubjectSelectionViewModel>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Teachers/Edit.css" asp-append-version="true" />
}

<div class="schedule-details-page">

    <!-- HEADER -->
    <div class="details-header">

        <div class="details-header-content">

            <div class="page-badge">
                ПРЕПОДАВАТЕЛИ
            </div>

            <h1>Изменить преподавателя</h1>

            <p>
                Обновите информацию о преподавателе
            </p>

        </div>

        <div class="details-header-actions">

            <a asp-action="Index" class="glass-button secondary-button">
                ← Назад
            </a>

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="glass-button primary-button">
                Просмотр
            </a>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="lesson-main-card">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- TOP -->
            <div class="lesson-card-top">

                <div class="lesson-icon edit-icon">
                    ✏️
                </div>

                <div>

                    <div class="lesson-label">
                        РЕДАКТИРОВАНИЕ
                    </div>

                    <h2>
                        @Model.FullName
                    </h2>

                    <p>
                        Измените данные преподавателя и сохраните изменения.
                    </p>

                </div>

            </div>


            <!-- FORM -->
            <div class="lesson-info-grid">


                <!-- ФИО -->
                <div class="info-card">

                    <div class="info-icon">
                        👤
                    </div>

                    <div class="info-content">

                        <label asp-for="FullName">
                            ФИО преподавателя
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Например: Иванов Иван Иванович"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- ПРЕДМЕТЫ -->
                <div class="info-card">

                    <div class="info-icon">
                        📚
                    </div>

                    <div class="info-content">

                        <label>
                            Предметы
                        </label>

                        <div class="subjects-selection">

                            @if (subjects.Any())
                            {
                                @foreach (var subject in subjects)
                                {
                                    <label class="subject-option">

                                        <input type="checkbox"
                                               name="subjectIds"
                                               value="@subject.Id"
                                               @(subject.IsSelected ? "checked" : null) />

                                        <span class="subject-option-content">

                                            <span class="subject-option-name">
                                                @subject.Name
                                            </span>

                                            <span class="subject-option-course">
                                                @subject.Course курс
                                            </span>

                                        </span>

                                    </label>
                                }
                            }
                            else
                            {
                                <div class="field-hint">
                                    Предметы пока не добавлены.
                                    Сначала добавьте предметы в разделе «Предметы».
                                </div>
                            }

                        </div>

                        <div class="field-hint">
                            Выберите все предметы, которые преподаёт сотрудник.
                        </div>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->
            <div class="details-footer">

                <a asp-action="Index"
                   class="glass-button secondary-button">
                    ← Отмена
                </a>

                <button type="submit"
                        class="glass-button save-button">
                    ✓ Сохранить изменения
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}