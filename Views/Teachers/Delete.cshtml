@model ScheduleSystem.Models.Teacher

@{
    ViewData["Title"] = "Удаление преподавателя";

    var firstLetter = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName.Substring(0, 1).ToUpper()
        : "?";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Teachers/Delete.css" asp-append-version="true" />
}

<div class="schedule-details-page ui-form-layout">

    <!-- HEADER -->
    <div class="details-header ui-page-heading">

        <div class="details-header-content">

            <div class="page-badge">
                ПРЕПОДАВАТЕЛИ
            </div>

            <h1>
                Удаление преподавателя
            </h1>

            <p>
                Подтверждение удаления преподавателя из системы
            </p>

        </div>

        <div class="details-header-actions">

            <a asp-action="Index" class="glass-button ui-button secondary-button">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Назад
            </a>

            <a asp-action="Details" asp-route-id="@Model.Id" class="glass-button ui-button ui-primary primary-button">
                Подробнее
            </a>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="lesson-main-card ui-surface ui-panel">

        <!-- TOP -->
        <div class="lesson-card-top">

            <div class="lesson-icon delete-icon">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </div>

            <div>

                <div class="lesson-label">
                    ПОДТВЕРЖДЕНИЕ УДАЛЕНИЯ
                </div>

                <h2>
                    Вы уверены?
                </h2>

                <p>
                    Вы действительно хотите удалить этого преподавателя?
                    Это действие нельзя отменить.
                </p>

            </div>

        </div>


        <!-- TEACHER PROFILE -->
        <div class="teacher-profile">

            <div class="teacher-avatar">
                @firstLetter
            </div>

            <div class="teacher-main-info">

                <h3>
                    @Model.FullName
                </h3>

                @if (Model.TeacherSubjects != null &&
                     Model.TeacherSubjects.Any())
                {
                    <div class="teacher-subjects-list">

                        @foreach (var teacherSubject in Model.TeacherSubjects
                            .Where(ts => ts.Subject != null)
                            .OrderBy(ts => ts.Subject!.Name))
                        {
                            <span>
                                @teacherSubject.Subject!.Name
                            </span>
                        }

                    </div>
                }
                else
                {
                    <span>
                        Предметы не указаны
                    </span>
                }

            </div>

        </div>


        <!-- INFORMATION -->
        <div class="lesson-info-grid">

            <!-- ФИО -->
            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-person" aria-hidden="true"></i>
                </div>

                <div>
                    <span>
                        ФИО
                    </span>

                    <strong>
                        @Model.FullName
                    </strong>
                </div>

            </div>


            <!-- ПРЕДМЕТЫ -->
            <div class="info-card">

                <div class="info-icon">
                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                </div>

                <div>
                    <span>
                        Предметы
                    </span>

                    @if (Model.TeacherSubjects != null &&
                         Model.TeacherSubjects.Any())
                    {
                        <div class="teacher-subjects-list">

                            @foreach (var teacherSubject in Model.TeacherSubjects
                                .Where(ts => ts.Subject != null)
                                .OrderBy(ts => ts.Subject!.Name))
                            {
                                <strong>
                                    @teacherSubject.Subject!.Name
                                </strong>
                            }

                        </div>
                    }
                    else
                    {
                        <strong>
                            Не указаны
                        </strong>
                    }

                </div>

            </div>

        </div>


        <!-- WARNING -->
        <div class="warning-section">

            <div class="warning-icon">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            </div>

            <div>

                <strong>
                    Внимание
                </strong>

                <p>
                    После удаления преподавателя восстановить его данные
                    будет невозможно.
                </p>

            </div>

        </div>


        <!-- FOOTER -->
        <div class="details-footer">

            <a asp-action="Index" class="glass-button ui-button secondary-button">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Отмена
            </a>

            <form asp-action="Delete" method="post" class="delete-form">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="glass-button ui-button ui-danger delete-button">
                    <i class="bi bi-trash" aria-hidden="true"></i> Удалить преподавателя
                </button>

            </form>

        </div>

    </div>

</div>
