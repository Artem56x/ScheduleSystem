@model ScheduleSystem.Models.Teacher

@{
    ViewData["Title"] = "Удаление преподавателя";


    var firstLetter = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName.Substring(0, 1).ToUpper()
        : "?";


}

<div class="schedule-details-page">


    <!-- HEADER -->
    <div class="details-header">

        <div class="details-header-content">

            <div class="page-badge">
                ПРЕПОДАВАТЕЛИ
            </div>

            <h1>Удаление преподавателя</h1>

            <p>
                Подтверждение удаления преподавателя из системы
            </p>

        </div>

        <div class="details-header-actions">

            <a asp-action="Index" class="glass-button secondary-button">
                ← Назад
            </a>

            <a asp-action="Details" asp-route-id="@Model.Id" class="glass-button primary-button">
                Подробнее
            </a>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="lesson-main-card">

        <!-- TOP -->
        <div class="lesson-card-top">

            <div class="lesson-icon delete-icon">
                🗑️
            </div>

            <div>

                <div class="lesson-label">
                    ПОДТВЕРЖДЕНИЕ УДАЛЕНИЯ
                </div>

                <h2>Вы уверены?</h2>

                <p>
                    Вы действительно хотите удалить этого преподавателя?
                    Это действие нельзя отменить.
                </p>

            </div>

        </div>


        <!-- TEACHER PROFILE -->
        <div class="teacher-profile">

            <div class="teacher-avatar">
                @firstLetter
            </div>

            <div class="teacher-main-info">

                <h3>@Model.FullName</h3>

                @if (Model.Subject != null)
                {
                    <span>
                        @Model.Subject.Name
                    </span>
                }
                else
                {
                    <span>
                        Преподаватель
                    </span>
                }

            </div>

        </div>


        <!-- INFORMATION -->
        <div class="lesson-info-grid">

            <!-- ФИО -->
            <div class="info-card">

                <div class="info-icon">
                    👤
                </div>

                <div>
                    <span>ФИО</span>
                    <strong>@Model.FullName</strong>
                </div>

            </div>


            <!-- ПРЕДМЕТ -->
            <div class="info-card">

                <div class="info-icon">
                    📚
                </div>

                <div>
                    <span>Предмет</span>

                    <strong>
                        @if (Model.Subject != null)
                        {
                            @Model.Subject.Name
                        }
                        else
                        {
                            <span>Не указан</span>
                        }
                    </strong>

                </div>

            </div>


            <!-- EMAIL -->
            <div class="info-card">

                <div class="info-icon">
                    ✉️
                </div>

                <div>
                    <span>Email</span>

                    <strong>
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            @Model.Email
                        }
                        else
                        {
                            <span>Не указан</span>
                        }
                    </strong>

                </div>

            </div>

        </div>


        <!-- WARNING -->
        <div class="warning-section">

            <div class="warning-icon">
                ⚠️
            </div>

            <div>

                <strong>Внимание</strong>

                <p>
                    После удаления преподавателя восстановить его данные
                    будет невозможно.
                </p>

            </div>

        </div>


        <!-- FOOTER -->
        <div class="details-footer">

            <a asp-action="Index" class="glass-button secondary-button">
                ← Отмена
            </a>

            <form asp-action="Delete" method="post" class="delete-form">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="glass-button delete-button">
                    🗑 Удалить преподавателя
                </button>

            </form>

        </div>

    </div>


</div>

<style>
    /* ================================
       PAGE
       ================================ */

    .schedule-details-page {
        width: 100%;
        max-width: 1100px;

        margin: 0 auto;

        padding: 32px 20px 60px;
    }


    /* ================================
       HEADER
       ================================ */

    .details-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 30px;

        margin-bottom: 26px;
    }

    .details-header-content {
        min-width: 0;
    }

    .page-badge {
        display: inline-flex;
        align-items: center;

        padding: 7px 12px;

        margin-bottom: 12px;

        border-radius: 999px;

        background: rgba(0, 0, 0, 0.055);

        color: #666;

        font-size: 11px;
        font-weight: 750;

        letter-spacing: 0.8px;
    }

    .details-header h1 {
        margin: 0;

        color: #1c1c1e;

        font-size: 34px;
        font-weight: 750;

        letter-spacing: -1px;
    }

    .details-header p {
        margin: 8px 0 0;

        color: #777;

        font-size: 15px;
    }

    .details-header-actions {
        display: flex;

        gap: 10px;

        flex-shrink: 0;
    }


    /* ================================
       BUTTONS
       ================================ */

    .glass-button {
        min-height: 46px;

        padding: 11px 17px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        border-radius: 14px;

        text-decoration: none;

        font-size: 14px;
        font-weight: 650;

        transition:
            transform 0.2s ease,
            background 0.2s ease,
            box-shadow 0.2s ease;
    }

    .glass-button:hover {
        transform: translateY(-1px);
    }

    .secondary-button {
        color: #333;

        background: rgba(255, 255, 255, 0.65);

        border: 1px solid rgba(0, 0, 0, 0.08);
    }

    .secondary-button:hover {
        color: #111;

        background: rgba(255, 255, 255, 0.9);
    }

    .primary-button {
        color: #fff;

        background: rgba(0, 0, 0, 0.82);

        border: 1px solid rgba(0, 0, 0, 0.08);

        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    }

    .primary-button:hover {
        color: #fff;

        background: #000;
    }


    /* ================================
       MAIN CARD
       ================================ */

    .lesson-main-card {
        padding: 30px;

        border-radius: 28px;

        background: rgba(255, 255, 255, 0.48);

        border: 1px solid rgba(255, 255, 255, 0.75);

        box-shadow:
            0 30px 80px rgba(0, 0, 0, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.85);

        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
    }


    /* ================================
       CARD TOP
       ================================ */

    .lesson-card-top {
        display: flex;
        align-items: center;

        gap: 18px;

        padding-bottom: 26px;

        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .lesson-icon {
        width: 68px;
        height: 68px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 22px;

        font-size: 30px;
    }

    .delete-icon {
        background: rgba(255, 59, 48, 0.1);

        border: 1px solid rgba(255, 59, 48, 0.15);
    }

    .lesson-label {
        margin-bottom: 5px;

        color: #ff3b30;

        font-size: 11px;
        font-weight: 750;

        letter-spacing: 0.8px;
    }

    .lesson-card-top h2 {
        margin: 0;

        color: #1c1c1e;

        font-size: 27px;
        font-weight: 750;

        letter-spacing: -0.7px;
    }

    .lesson-card-top p {
        margin: 6px 0 0;

        color: #777;

        font-size: 14px;
        line-height: 1.5;
    }


    /* ================================
       TEACHER PROFILE
       ================================ */

    .teacher-profile {
        display: flex;
        align-items: center;

        gap: 16px;

        padding: 24px 0;
    }

    .teacher-avatar {
        width: 62px;
        height: 62px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: rgba(0, 0, 0, 0.065);

        color: #222;

        font-size: 24px;
        font-weight: 750;
    }

    .teacher-main-info h3 {
        margin: 0;

        color: #1c1c1e;

        font-size: 20px;
        font-weight: 700;

        letter-spacing: -0.3px;
    }

    .teacher-main-info span {
        display: block;

        margin-top: 4px;

        color: #777;

        font-size: 14px;
    }


    /* ================================
       INFO GRID
       ================================ */

    .lesson-info-grid {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 12px;
    }

    .info-card {
        min-height: 78px;

        display: flex;
        align-items: center;

        gap: 13px;

        padding: 16px;

        border-radius: 18px;

        background: rgba(255, 255, 255, 0.52);

        border: 1px solid rgba(0, 0, 0, 0.055);
    }

    .info-icon {
        width: 42px;
        height: 42px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background: rgba(0, 0, 0, 0.05);

        font-size: 18px;
    }

    .info-card span {
        display: block;

        margin-bottom: 3px;

        color: #888;

        font-size: 11px;
        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: 0.5px;
    }

    .info-card strong {
        display: block;

        color: #222;

        font-size: 14px;
        font-weight: 650;

        word-break: break-word;
    }


    /* ================================
       WARNING
       ================================ */

    .warning-section {
        display: flex;
        align-items: flex-start;

        gap: 13px;

        margin-top: 20px;
        padding: 17px;

        border-radius: 18px;

        background: rgba(255, 149, 0, 0.08);

        border: 1px solid rgba(255, 149, 0, 0.14);
    }

    .warning-icon {
        width: 38px;
        height: 38px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        background: rgba(255, 149, 0, 0.1);

        font-size: 18px;
    }

    .warning-section strong {
        display: block;

        margin-bottom: 3px;

        color: #9a5a00;

        font-size: 14px;
    }

    .warning-section p {
        margin: 0;

        color: #8a6a3d;

        font-size: 13px;

        line-height: 1.5;
    }


    /* ================================
       FOOTER
       ================================ */

    .details-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 12px;

        margin-top: 24px;
        padding-top: 22px;

        border-top: 1px solid rgba(0, 0, 0, 0.06);
    }

    .delete-form {
        margin: 0;
    }

    .delete-button {
        border: none;

        color: #fff;

        background: #ff3b30;

        cursor: pointer;

        box-shadow: 0 9px 22px rgba(255, 59, 48, 0.2);
    }

    .delete-button:hover {
        color: #fff;

        background: #e93228;

        box-shadow: 0 13px 28px rgba(255, 59, 48, 0.27);
    }


    /* ================================
       RESPONSIVE
       ================================ */

    @@media (max-width: 800px) {

        .details-header {
            align-items: flex-start;

            flex-direction: column;

            gap: 18px;
        }

        .details-header-actions {
            width: 100%;
        }

        .details-header-actions .glass-button {
            flex: 1;
        }

        .lesson-info-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 600px) {

        .schedule-details-page {
            padding: 25px 14px 50px;
        }

        .details-header h1 {
            font-size: 28px;
        }

        .details-header p {
            font-size: 14px;
        }

        .lesson-main-card {
            padding: 22px 18px;

            border-radius: 24px;
        }

        .lesson-card-top {
            align-items: flex-start;
        }

        .lesson-icon {
            width: 58px;
            height: 58px;

            border-radius: 19px;

            font-size: 25px;
        }

        .lesson-card-top h2 {
            font-size: 23px;
        }

        .teacher-profile {
            padding: 20px 0;
        }

        .teacher-avatar {
            width: 54px;
            height: 54px;

            border-radius: 17px;

            font-size: 21px;
        }

        .teacher-main-info h3 {
            font-size: 17px;
        }

        .details-footer {
            flex-direction: column-reverse;

            align-items: stretch;
        }

        .details-footer .glass-button,
        .delete-form,
        .delete-form .glass-button {
            width: 100%;
        }
    }


    @@media (max-width: 420px) {

        .details-header-actions {
            flex-direction: column;
        }

        .details-header-actions .glass-button {
            width: 100%;
        }

        .lesson-card-top {
            gap: 13px;
        }

        .info-card {
            padding: 14px;
        }
    }


    @@media (prefers-reduced-motion: reduce) {

        .glass-button {
            transition: none;
        }
    }
</style>
