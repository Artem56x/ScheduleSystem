@model ScheduleSystem.Models.Teacher

@{
    ViewData["Title"] = "Добавить преподавателя";

    var subjects = ViewBag.Subjects
        as IEnumerable<ScheduleSystem.ViewModels.SubjectSelectionViewModel>
        ?? Enumerable.Empty<ScheduleSystem.ViewModels.SubjectSelectionViewModel>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Teachers/Create.css" asp-append-version="true" />
}

<div class="schedule-details-page ui-form-layout">

    <!-- HEADER -->
    <div class="details-header ui-page-heading">

        <div class="details-header-content">

            <div class="page-badge">
                ПРЕПОДАВАТЕЛИ
            </div>

            <h1>Добавить преподавателя</h1>

            <p>
                Добавьте нового преподавателя в систему
            </p>

        </div>

        <div class="details-header-actions">

            <a asp-action="Index" class="glass-button ui-button secondary-button">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Назад
            </a>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="lesson-main-card ui-surface ui-panel">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary">
            </div>


            <!-- TOP -->
            <div class="lesson-card-top">

                <div class="lesson-icon teacher-icon">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                </div>

                <div>

                    <div class="lesson-label">
                        НОВЫЙ ПРЕПОДАВАТЕЛЬ
                    </div>

                    <h2>
                        Добавление преподавателя
                    </h2>

                    <p>
                        Заполните основные данные преподавателя.
                    </p>

                </div>

            </div>


            <!-- FORM -->
            <div class="lesson-info-grid">

                <!-- ФИО -->
                <div class="info-card">

                    <div class="info-icon">
                        <i class="bi bi-person" aria-hidden="true"></i>
                    </div>

                    <div class="info-content">

                        <label asp-for="FullName">
                            ФИО преподавателя
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Например: Иванов Иван Иванович"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- ПРЕДМЕТЫ -->
                <div class="info-card">

                    <div class="info-icon">
                        <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                    </div>

                    <div class="info-content">

                        <label>
                            Предметы
                        </label>

                        <div class="subjects-selection">

                            @if (subjects.Any())
                            {
                                @foreach (var subject in subjects)
                                {
                                    <label class="subject-option">

                                        <input type="checkbox"
                                               name="subjectIds"
                                               value="@subject.Id"
                                               @(subject.IsSelected ? "checked" : null) />

                                        <span class="subject-option-content">

                                            <span class="subject-option-name">
                                                @subject.Name
                                            </span>

                                            <span class="subject-option-course">
                                                @subject.Course курс
                                            </span>

                                        </span>

                                    </label>
                                }
                            }
                            else
                            {
                                <div class="field-hint">
                                    Предметы пока не добавлены.
                                    Сначала добавьте предметы в разделе «Предметы».
                                </div>
                            }

                        </div>

                        <div class="field-hint">
                            Выберите все предметы, которые преподаёт сотрудник.
                        </div>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->
            <div class="details-footer">

                <a asp-action="Index"
                   class="glass-button ui-button secondary-button">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> Отмена
                </a>

                <button type="submit"
                        class="glass-button ui-button ui-primary save-button">
                    <i class="bi bi-check2" aria-hidden="true"></i> Добавить преподавателя
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
