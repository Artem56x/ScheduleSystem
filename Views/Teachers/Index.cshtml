@model IEnumerable<ScheduleSystem.Models.Teacher>

@{
    ViewData["Title"] = "Преподаватели";
    var search = ViewBag.Search as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Teachers/Index.css" asp-append-version="true" />
}

<div class="teachers-page ui-directory">

    <!-- HEADER -->
    <div class="page-header ui-page-heading">

        <div>
            <h1>Преподаватели</h1>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="add-teacher-btn ui-button ui-primary">
                <span><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                Добавить преподавателя
            </a>
        }

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message-glass ui-alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- SEARCH -->
    <form asp-action="Index" method="get" class="search-card">

        <div class="search-wrapper">

            <span class="search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>

            <input type="text" name="search" aria-label="Поиск в справочнике" value="@search" class="search-input"
                   placeholder="Поиск по ФИО или предмету..." autocomplete="off" />

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index" class="clear-search" title="Очистить поиск">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </a>
            }

        </div>

        <button type="submit" class="search-btn ui-button">
            Найти
        </button>

    </form>

    @if (Model.Any())
    {
        <div class="teachers-count">
            Найдено преподавателей:
            <strong>@Model.Count()</strong>
        </div>

        <!-- TABLE -->
        <p class="table-scroll-hint">На небольшом экране таблицу можно прокручивать по горизонтали.</p><div class="glass-table-card" tabindex="0" role="region" aria-label="Список преподавателей"><table class="entity-table"><caption class="visually-hidden">Список преподавателей</caption>

            <!-- TABLE HEADER -->
            <thead><tr class="table-header">

                <th scope="col">
                    Преподаватель
                </th>

                <th scope="col">
                    Предметы
                </th>

                <th scope="col">
                    Действия
                </th>

            </tr></thead><tbody>

            <!-- ROWS -->
            @foreach (var item in Model)
            {
                <tr class="teacher-row">

                    <!-- TEACHER -->
                    <td><div class="teacher-info">

                        <div class="teacher-avatar">
                            @(string.IsNullOrWhiteSpace(item.FullName)
                                ? "?"
                                : item.FullName.Substring(0, 1).ToUpper())
                        </div>

                        <div class="teacher-text">

                            <div class="teacher-name">
                                @item.FullName
                            </div>

                            <div class="teacher-label">
                                Преподаватель
                            </div>

                        </div>

                    </div></td>

                    <!-- SUBJECTS -->
                    <td><div class="teacher-subject">

                        @if (item.TeacherSubjects != null &&
                             item.TeacherSubjects.Any())
                        {
                            <div class="teacher-subjects-list">

                                @foreach (var teacherSubject in item.TeacherSubjects
                                    .Where(ts => ts.Subject != null)
                                    .OrderBy(ts => ts.Subject!.Name))
                                {
                                    <span class="subject-badge">
                                        <span class="subject-icon"><i class="bi bi-journal-bookmark" aria-hidden="true"></i></span>
                                        @teacherSubject.Subject!.Name
                                    </span>
                                }

                            </div>
                        }
                        else
                        {
                            <span class="empty-value">
                                Не указаны
                            </span>
                        }

                    </div></td>

                    <!-- ACTIONS -->
                    <td><div class="teacher-actions">

                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn ui-button details-btn">
                            Подробнее
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn ui-button edit-btn">
                                Изменить
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn ui-button ui-danger-outline delete-btn">
                                Удалить
                            </a>
                        }

                    </div></td>

                </tr>
            }

        </tbody></table></div>

        @if (!string.IsNullOrWhiteSpace(search))
        {
            <div class="search-result-info">
                По запросу «@search» найдено:
                <strong>@Model.Count()</strong>
            </div>
        }
    }
    else
    {
        <!-- EMPTY -->
        <div class="empty-state">

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <div class="empty-icon">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </div>

                <h2>Преподаватели не найдены</h2>

                <p>
                    По запросу
                    <strong>«@search»</strong>
                    ничего не найдено.
                </p>

                <a asp-action="Index" class="clear-btn ui-button">
                    Сбросить поиск
                </a>
            }
            else
            {
                <div class="empty-icon">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                </div>

                <h2>Преподавателей пока нет</h2>

                <p>
                    Добавьте первого преподавателя,
                    чтобы он появился в системе.
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="add-teacher-btn ui-button ui-primary">
                        <span><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                        Добавить преподавателя
                    </a>
                }
            }

        </div>
    }

</div>
