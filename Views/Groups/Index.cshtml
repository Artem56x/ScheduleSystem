@model IEnumerable<ScheduleSystem.Models.Group>

@{
    ViewData["Title"] = "Группы";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Groups/Index.css" asp-append-version="true" />
}

<div class="groups-page ui-directory">

    <!-- Заголовок -->
    <div class="page-header ui-page-heading">

        <div>
            <h1>Группы</h1>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="add-group-btn ui-button ui-primary">
                <span><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                Добавить группу
            </a>
        }

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message-glass ui-alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Поиск -->
    <form asp-action="Index" method="get" class="search-card">

        <div class="search-wrapper">

            <span class="search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>

            <input type="text" name="search" aria-label="Поиск в справочнике" value="@ViewBag.Search" class="search-input"
                   placeholder="Поиск по названию группы или специальности..." />

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a asp-action="Index" class="clear-search">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </a>
            }

        </div>

        <button type="submit" class="search-btn ui-button">
            Найти
        </button>

    </form>

    @if (Model.Any())
    {
        <div class="groups-count">
            Найдено групп: <strong>@Model.Count()</strong>
        </div>

        <!-- Таблица -->
        <p class="table-scroll-hint">На небольшом экране таблицу можно прокручивать по горизонтали.</p><div class="glass-table-card" tabindex="0" role="region" aria-label="Список групп"><table class="entity-table"><caption class="visually-hidden">Список групп</caption>

            <thead><tr class="table-header">

                <th scope="col">Группа</th>

                <th scope="col">Специальность</th>

                <th scope="col">Курс</th>

                <th scope="col">Количество человек</th>

                <th scope="col">Действия</th>

            </tr></thead><tbody>

            @foreach (var item in Model)
            {
                <tr class="group-row">

                    <!-- Группа -->
                    <td><div class="group-info">

                        <div class="group-avatar">
                            @(string.IsNullOrWhiteSpace(item.Name)
                                ? "?"
                                : item.Name.Substring(0, 1).ToUpper())
                        </div>

                        <div class="group-text">

                            <div class="group-name">
                                @item.Name
                            </div>

                            <div class="group-label">
                                Учебная группа
                            </div>

                        </div>

                    </div></td>

                    <!-- Специальность -->
                    <td><div class="group-specialty">

                        @if (!string.IsNullOrWhiteSpace(item.Specialty))
                        {
                            <span>
                                @item.Specialty
                            </span>
                        }
                        else
                        {
                            <span class="empty-value">
                                Не указана
                            </span>
                        }

                    </div></td>

                    <!-- Курс -->
                    <td><div class="group-course">

                        <span class="course-badge">
                            @item.Course курс
                        </span>

                    </div></td>

                    <!-- Количество студентов -->
                    <td><div>

                        <span class="student-count">
                            <span class="student-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                            @item.StudentCount
                            <span class="student-label">
                                чел.
                            </span>
                        </span>

                    </div></td>

                    <!-- Действия -->
                    <td><div class="group-actions">

                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn ui-button details-btn">
                            Подробнее
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn ui-button edit-btn">
                                Изменить
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn ui-button ui-danger-outline delete-btn">
                                Удалить
                            </a>
                        }

                    </div></td>

                </tr>
            }

        </tbody></table></div>
    }
    else
    {
        <div class="empty-state">

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <div class="empty-icon">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </div>

                <h2>Группы не найдены</h2>

                <p>
                    По запросу
                    <strong>«@ViewBag.Search»</strong>
                    ничего не найдено.
                </p>

                <a asp-action="Index" class="clear-btn ui-button">
                    Сбросить поиск
                </a>
            }
            else
            {
                <div class="empty-icon">
                    <i class="bi bi-people" aria-hidden="true"></i>
                </div>

                <h2>Групп пока нет</h2>

                <p>
                    Добавьте первую учебную группу,
                    чтобы она появилась в системе.
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="add-group-btn ui-button ui-primary">
                        <span><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                        Добавить группу
                    </a>
                }
            }

        </div>
    }

</div>
