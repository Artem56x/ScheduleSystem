@model ScheduleSystem.Models.Group

@{
    ViewData["Title"] = "Редактировать группу";
}

<div class="form-page">

    <!-- Заголовок -->
    <div class="form-header">

        <div class="form-icon">
            👥
        </div>

        <div>
            <h1>Редактировать группу</h1>
            <p>Измените данные учебной группы</p>
        </div>

    </div>

    <!-- Форма -->
    <div class="glass-form-card">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
            </div>

            <!-- Название группы -->
            <div class="form-field">

                <label asp-for="Name">
                    Название группы
                </label>

                <input asp-for="Name" class="form-control" placeholder="Например: 24ИС-1" />

                <span asp-validation-for="Name" class="text-danger">
                </span>

            </div>

            <!-- Специальность -->
            <div class="form-field">

                <label asp-for="Specialty">
                    Специальность
                </label>

                <input asp-for="Specialty" class="form-control"
                       placeholder="Например: Информационные системы и программирование" />

                <span asp-validation-for="Specialty" class="text-danger">
                </span>

            </div>

            <!-- Количество человек -->
            <div class="form-field">

                <label asp-for="StudentCount">
                    Количество человек
                </label>

                <div class="number-wrapper">

                    <input asp-for="StudentCount" type="number" min="1" max="100" class="form-control"
                           placeholder="Например: 25" />

                    <span class="number-suffix">
                        чел.
                    </span>

                </div>

                <span asp-validation-for="StudentCount" class="text-danger">
                </span>

            </div>

            <!-- Описание -->
            <div class="form-field">

                <label asp-for="Description">
                    Описание
                    <span class="optional">
                        необязательно
                    </span>
                </label>

                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Дополнительная информация о группе..."></textarea>

                <span asp-validation-for="Description" class="text-danger">
                </span>

            </div>

            <!-- Кнопки -->
            <div class="form-actions">

                <button type="submit" class="btn glass-primary-btn">

                    ✓
                    Сохранить изменения

                </button>

                <a asp-action="Index" class="btn glass-secondary-btn">

                    Отмена

                </a>

            </div>

        </form>

    </div>

</div>

<style>
    /* =========================
       Страница
       ========================= */

    .form-page {
        max-width: 760px;
        margin: 0 auto;
    }

    /* =========================
       Заголовок
       ========================= */

    .form-header {
        display: flex;
        align-items: center;

        gap: 15px;

        margin-bottom: 25px;
    }

    .form-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 52px;
        height: 52px;

        flex-shrink: 0;

        border-radius: 16px;

        background:
            rgba(255, 255, 255, 0.55);

        border:
            1px solid rgba(255, 255, 255, 0.7);

        backdrop-filter:
            blur(15px);

        -webkit-backdrop-filter:
            blur(15px);

        font-size: 25px;

        box-shadow:
            0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .form-header h1 {
        margin: 0 0 5px;

        font-size: 2rem;
        font-weight: 700;

        letter-spacing: -0.5px;
    }

    .form-header p {
        margin: 0;

        color: #6c757d;
    }

    /* =========================
       Glass форма
       ========================= */

    .glass-form-card {
        padding: 30px;

        border:
            1px solid rgba(255, 255, 255, 0.7);

        border-radius: 22px;

        background:
            rgba(255, 255, 255, 0.55);

        backdrop-filter:
            blur(25px) saturate(160%);

        -webkit-backdrop-filter:
            blur(25px) saturate(160%);

        box-shadow:
            0 15px 40px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    /* =========================
       Поля
       ========================= */

    .form-field {
        margin-bottom: 22px;
    }

    .form-field label {
        display: block;

        margin-bottom: 8px;

        color: #343434;

        font-size: 0.9rem;
        font-weight: 600;
    }

    .optional {
        margin-left: 5px;

        color: #999;

        font-size: 0.75rem;
        font-weight: 400;
    }

    .form-field .form-control {
        width: 100%;

        min-height: 48px;

        border:
            1px solid rgba(0, 0, 0, 0.08);

        border-radius: 13px;

        background:
            rgba(255, 255, 255, 0.7);

        box-shadow:
            inset 0 1px 2px rgba(0, 0, 0, 0.02);

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }

    .form-field textarea.form-control {
        min-height: 110px;

        resize: vertical;
    }

    .form-field .form-control:focus {
        border-color:
            rgba(0, 122, 255, 0.35);

        background:
            rgba(255, 255, 255, 0.85);

        box-shadow:
            0 0 0 4px rgba(0, 122, 255, 0.08);

        outline: none;
    }

    .form-field .form-control::placeholder {
        color: #a0a0a5;
    }

    /* =========================
       Количество человек
       ========================= */

    .number-wrapper {
        position: relative;
    }

    .number-wrapper .form-control {
        padding-right: 60px;
    }

    .number-suffix {
        position: absolute;

        top: 50%;
        right: 15px;

        transform:
            translateY(-50%);

        color: #999;

        font-size: 0.85rem;

        pointer-events: none;
    }

    /* =========================
       Ошибки
       ========================= */

    .text-danger {
        display: block;

        margin-top: 6px;

        font-size: 0.8rem;
    }

    /* =========================
       Кнопки
       ========================= */

    .form-actions {
        display: flex;
        align-items: center;

        gap: 10px;

        margin-top: 30px;
        padding-top: 22px;

        border-top:
            1px solid rgba(0, 0, 0, 0.06);
    }

    /* Сохранить */

    .glass-primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        border: none;

        border-radius: 13px;

        padding: 11px 18px;

        color: white;

        font-weight: 600;

        background:
            linear-gradient(135deg, #007aff, #5856d6);

        box-shadow:
            0 8px 20px rgba(0, 122, 255, 0.20);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;

        cursor: pointer;
    }

    .glass-primary-btn:hover {
        color: white;

        transform:
            translateY(-1px);

        box-shadow:
            0 10px 25px rgba(0, 122, 255, 0.28);
    }

    /* Отмена */

    .glass-secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        border:
            1px solid rgba(255, 255, 255, 0.8);

        border-radius: 13px;

        padding: 11px 18px;

        background:
            rgba(255, 255, 255, 0.55);

        color: #555;

        text-decoration: none;

        backdrop-filter:
            blur(10px);

        -webkit-backdrop-filter:
            blur(10px);

        transition: 0.2s ease;
    }

    .glass-secondary-btn:hover {
        background:
            rgba(255, 255, 255, 0.85);

        color: #222;
    }

    /* =========================
       Мобильная версия
       ========================= */

    @@media (max-width: 600px) {

        .form-page {
            width: 100%;
        }

        .glass-form-card {
            padding: 20px;

            border-radius: 18px;
        }

        .form-header {
            align-items: flex-start;
        }

        .form-header h1 {
            font-size: 1.6rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .form-actions .btn {
            width: 100%;
        }

    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

