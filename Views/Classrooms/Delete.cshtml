@model ScheduleSystem.Models.Classroom

@{
    ViewData["Title"] = "Удаление аудитории";
}

<div class="classroom-delete-page">

    <div class="page-header">
        <div>
            <h1>Удаление аудитории</h1>
            <p>Удаление учебной аудитории из системы</p>
        </div>
    </div>

    <div class="glass-delete-card">

        <div class="delete-icon">
            ⚠️
        </div>

        <div class="delete-title">
            <h2>Вы уверены, что хотите удалить аудиторию?</h2>
            <p>
                Это действие нельзя отменить. Аудитория будет удалена из системы.
            </p>
        </div>

        <div class="classroom-info-card">

            <div class="classroom-avatar">
                @(string.IsNullOrWhiteSpace(Model.Name)
                    ? "?"
                    : Model.Name.Substring(0, 1).ToUpper())
            </div>

            <div class="classroom-main-info">

                <div class="classroom-name">
                    @Model.Name
                </div>

                <div class="classroom-label">
                    @(Model.ClassroomCategory?.Name ?? "Категория не указана")
                </div>

            </div>

        </div>

        <div class="details-list">

            <div class="detail-row">
                <span class="detail-label">
                    Номер аудитории
                </span>

                <span class="detail-value">
                    @Model.Name
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">
                    Категория
                </span>

                <span class="detail-value">
                    @(Model.ClassroomCategory?.Name ?? "Не указана")
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">
                    Количество мест
                </span>

                <span class="detail-value">
                    @Model.Capacity мест
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">
                    Компьютеры
                </span>

                <span class="detail-value">
                    @(Model.HasComputers ? "Есть" : "Нет")
                </span>
            </div>

        </div>

        <div class="warning-message">
            <span>⚠</span>
            <span>
                Если аудитория используется в расписании,
                удалить её будет невозможно.
            </span>
        </div>

        <form asp-action="Delete" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="form-actions">

                <button type="submit" class="btn delete-btn">
                    Удалить аудиторию
                </button>

                <a asp-action="Index" class="btn cancel-btn">
                    Отмена
                </a>

            </div>

        </form>

    </div>

</div>

<style>
    .classroom-delete-page {
        max-width: 700px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0 0 5px;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .page-header p {
        margin: 0;
        color: #6c757d;
    }

    .glass-delete-card {
        padding: 30px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(25px) saturate(160%);
        -webkit-backdrop-filter: blur(25px) saturate(160%);
        box-shadow:
            0 15px 40px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .delete-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        margin-bottom: 18px;
        border-radius: 20px;
        background: rgba(220, 53, 69, 0.10);
        font-size: 27px;
    }

    .delete-title {
        margin-bottom: 25px;
    }

    .delete-title h2 {
        margin: 0 0 7px;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .delete-title p {
        margin: 0;
        color: #777;
        font-size: 0.9rem;
    }

    .classroom-info-card {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding: 18px;
        border: 1px solid rgba(255, 255, 255, 0.75);
        border-radius: 17px;
        background: rgba(255, 255, 255, 0.45);
    }

    .classroom-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 16px;
        background: linear-gradient(135deg, #007aff, #5856d6);
        color: white;
        font-size: 20px;
        font-weight: 700;
        box-shadow: 0 7px 18px rgba(0, 122, 255, 0.18);
    }

    .classroom-name {
        color: #252525;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .classroom-label {
        margin-top: 3px;
        color: #999;
        font-size: 0.8rem;
    }

    .details-list {
        overflow: hidden;
        margin-bottom: 20px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.35);
    }

    .detail-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 17px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #888;
        font-size: 0.9rem;
    }

    .detail-value {
        color: #333;
        font-weight: 600;
        text-align: right;
    }

    .warning-message {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 25px;
        padding: 14px 16px;
        border: 1px solid rgba(220, 53, 69, 0.12);
        border-radius: 14px;
        background: rgba(220, 53, 69, 0.07);
        color: #b02a37;
        font-size: 0.88rem;
    }

    .warning-message span:first-child {
        flex-shrink: 0;
        font-size: 17px;
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .delete-btn {
        border: none;
        border-radius: 13px;
        padding: 11px 18px;
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: white;
        font-weight: 600;
        box-shadow: 0 8px 20px rgba(220, 53, 69, 0.18);
        transition: 0.2s ease;
    }

    .delete-btn:hover {
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 10px 25px rgba(220, 53, 69, 0.26);
    }

    .cancel-btn {
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 13px;
        padding: 11px 18px;
        background: rgba(255, 255, 255, 0.55);
        color: #555;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .cancel-btn:hover {
        background: rgba(255, 255, 255, 0.85);
        color: #222;
    }

    @@media (max-width: 600px) {

        .classroom-delete-page {
            width: 100%;
        }

        .page-header h1 {
            font-size: 1.6rem;
        }

        .glass-delete-card {
            padding: 20px;
            border-radius: 18px;
        }

        .detail-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 4px;
        }

        .detail-value {
            text-align: left;
        }

        .form-actions {
            flex-direction: column;
        }

        .form-actions .btn {
            width: 100%;
        }

    }
</style>

