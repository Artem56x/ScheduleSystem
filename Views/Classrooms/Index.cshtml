@model IEnumerable<ScheduleSystem.Models.Classroom>

@{
    ViewData["Title"] = "Аудитории";
    var search = ViewBag.Search as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Classrooms/Index.css" asp-append-version="true" />
}

<div class="classrooms-page ui-directory">

    <!-- HEADER -->
    <div class="page-header ui-page-heading">

        <div>
            <h1>Аудитории</h1>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="add-classroom-btn ui-button ui-primary">

                <span><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                Добавить аудиторию

            </a>
        }

    </div>

    <!-- ERROR -->
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="glass-alert ui-alert">

            <span><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
            <span>@errorMessage</span>

        </div>
    }

    <!-- SEARCH -->
    <form asp-action="Index" method="get" class="search-card">

        <div class="search-wrapper">

            <span class="search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>

            <input type="text" name="search" aria-label="Поиск в справочнике" value="@search" class="search-input"
                   placeholder="Поиск по номеру или категории..." autocomplete="off" />

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index" class="clear-search" title="Очистить поиск">

                    <i class="bi bi-x-lg" aria-hidden="true"></i>

                </a>
            }

        </div>

        <button type="submit" class="search-btn ui-button">

            Найти

        </button>

    </form>

    @if (Model.Any())
    {
        <div class="classrooms-count">

            Найдено аудиторий:
            <strong>@Model.Count()</strong>

        </div>

        <!-- TABLE -->
        <p class="table-scroll-hint">На небольшом экране таблицу можно прокручивать по горизонтали.</p><div class="glass-table-card" tabindex="0" role="region" aria-label="Список аудиторий"><table class="entity-table"><caption class="visually-hidden">Список аудиторий</caption>

            <!-- TABLE HEADER -->
            <thead><tr class="table-header">

                <th scope="col">Аудитория</th>
                <th scope="col">Категория</th>
                <th scope="col">Места</th>
                <th scope="col">Действия</th>

            </tr></thead><tbody>

            @foreach (var item in Model)
            {
                <tr class="classroom-row">

                    <!-- АУДИТОРИЯ -->
                    <td><div class="classroom-info">

                        <div class="classroom-avatar">

                            @(string.IsNullOrWhiteSpace(item.Name)
                                ? "?"
                                : item.Name.Substring(0, 1).ToUpper())

                        </div>

                        <div class="classroom-text">

                            <div class="classroom-name">
                                @item.Name
                            </div>

                            <div class="classroom-label">
                                Номер аудитории
                            </div>

                        </div>

                    </div></td>

                    <!-- КАТЕГОРИЯ -->
                    <td><div class="category-info">

                        @if (item.ClassroomCategory != null)
                        {
                            <span class="category-badge">

                                @item.ClassroomCategory.Name

                            </span>
                        }
                        else
                        {
                            <span class="empty-value">
                                Не указана
                            </span>
                        }

                    </div></td>

                    <!-- ВМЕСТИМОСТЬ -->
                    <td><div class="capacity-info">

                        <span class="capacity-number">
                            @item.Capacity
                        </span>

                        <span class="capacity-label">
                            мест
                        </span>

                    </div></td>

                    <!-- ДЕЙСТВИЯ -->
                    <td><div class="classroom-actions">

                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn ui-button details-btn">

                            Подробнее

                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn ui-button edit-btn">

                                Изменить

                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn ui-button ui-danger-outline delete-btn">

                                Удалить

                            </a>
                        }

                    </div></td>

                </tr>
            }

        </tbody></table></div>

        @if (!string.IsNullOrWhiteSpace(search))
        {
            <div class="search-result-info">

                По запросу «@search» найдено:
                <strong>@Model.Count()</strong>

            </div>
        }
    }
    else
    {
        <!-- EMPTY STATE -->
        <div class="empty-state">

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <div class="empty-icon">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </div>

                <h2>Аудитории не найдены</h2>

                <p>

                    По запросу
                    <strong>«@search»</strong>
                    ничего не найдено.

                </p>

                <a asp-action="Index" class="clear-btn ui-button">

                    Сбросить поиск

                </a>
            }
            else
            {
                <div class="empty-icon">
                    <i class="bi bi-door-open" aria-hidden="true"></i>
                </div>

                <h2>Аудиторий пока нет</h2>

                <p>

                    Добавьте первую аудиторию,
                    чтобы использовать её в расписании.

                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="add-classroom-btn ui-button ui-primary">

                        <span><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                        Добавить аудиторию

                    </a>
                }
            }

        </div>
    }

</div>
