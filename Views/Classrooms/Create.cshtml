@model ScheduleSystem.Models.Classroom

@{
    ViewData["Title"] = "Добавить аудиторию";
}

<div class="classroom-form-page">

    <div class="page-header">
        <div>
            <h1>Добавить аудиторию</h1>
            <p>Создание новой учебной аудитории</p>
        </div>
    </div>

    <div class="glass-form-card">

        <div class="form-icon">
            🏫
        </div>

        <div class="form-title">
            <h2>
                Информация об аудитории
            </h2>

            <p>
                Укажите номер, категорию, количество мест и оборудование.
            </p>
        </div>

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="glass-validation">
            </div>

            <!-- НОМЕР АУДИТОРИИ -->

            <div class="form-group">

                <label asp-for="Name" class="form-label">
                    Номер аудитории
                </label>

                <input asp-for="Name" class="form-control glass-input" placeholder="Например: 305" autocomplete="off" />

                <span asp-validation-for="Name" class="text-danger">
                </span>

            </div>

            <!-- КАТЕГОРИЯ -->

            <div class="form-group">

                <label asp-for="ClassroomCategoryId" class="form-label">

                    Категория

                </label>

                <div class="category-row">

                    <select asp-for="ClassroomCategoryId" asp-items="ViewBag.ClassroomCategories"
                            class="form-control glass-input" id="classroomCategorySelect">

                        <option value="">
                            Выберите категорию
                        </option>

                    </select>

                    <button type="button" class="add-category-btn" id="openCategoryModal">

                        <span>＋</span>

                        Добавить

                    </button>

                </div>

                <span asp-validation-for="ClassroomCategoryId" class="text-danger">
                </span>

            </div>

            <!-- КОЛИЧЕСТВО МЕСТ -->

            <div class="form-group">

                <label asp-for="Capacity" class="form-label">

                    Количество мест

                </label>

                <input asp-for="Capacity" type="number" min="1" max="500" class="form-control glass-input"
                       placeholder="Например: 30" />

                <span asp-validation-for="Capacity" class="text-danger">
                </span>

            </div>

            <!-- КОМПЬЮТЕРЫ -->

            <div class="equipment-option">

                <div class="equipment-info">

                    <div class="equipment-icon">
                        💻
                    </div>

                    <div>

                        <div class="equipment-title">
                            Есть компьютеры
                        </div>

                        <div class="equipment-description">
                            В аудитории установлены компьютеры
                        </div>

                    </div>

                </div>

                <label class="switch">

                    <input asp-for="HasComputers" />

                    <span class="slider"></span>

                </label>

            </div>

            <span asp-validation-for="HasComputers" class="text-danger">
            </span>

            <!-- КНОПКИ -->

            <div class="form-actions">

                <button type="submit" class="btn save-btn">

                    Добавить аудиторию

                </button>

                <a asp-action="Index" class="btn cancel-btn">

                    Отмена

                </a>

            </div>

        </form>

    </div>

    
</div>

<!-- МОДАЛЬНОЕ ОКНО ДОБАВЛЕНИЯ КАТЕГОРИИ -->

<div class="category-modal-overlay" id="categoryModal">

    
    <div class="category-modal">

        <button type="button" class="category-modal-close" id="closeCategoryModal">

            ×

        </button>

        <div class="modal-icon">
            🏷️
        </div>

        <h3>
            Новая категория
        </h3>

        <p>
            Добавьте новую категорию аудитории.
        </p>

        <div class="modal-form-group">

            <label for="newCategoryName">
                Название категории
            </label>

            <input type="text" id="newCategoryName" class="form-control glass-input" placeholder="Например: Лаборатория"
                   maxlength="100" autocomplete="off" />

            <div class="category-error" id="categoryError">
            </div>

        </div>

        <div class="modal-actions">

            <button type="button" class="modal-cancel-btn" id="cancelCategory">

                Отмена

            </button>

            <button type="button" class="modal-save-btn" id="saveCategory">

                Добавить категорию

            </button>

        </div>

    </div>

    
</div>

<style>
    .classroom-form-page {
        max-width: 700px;
        margin: 0 auto;
    }

    /* HEADER */

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0 0 5px;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .page-header p {
        margin: 0;
        color: #6c757d;
    }

    /* CARD */

    .glass-form-card {
        padding: 30px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(25px) saturate(160%);
        -webkit-backdrop-filter: blur(25px) saturate(160%);
        box-shadow:
            0 15px 40px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    /* ICON */

    .form-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        margin-bottom: 18px;
        border-radius: 20px;
        background: linear-gradient(135deg, #007aff, #5856d6);
        color: white;
        font-size: 27px;
        box-shadow:
            0 8px 20px rgba(0, 122, 255, 0.20);
    }

    /* TITLE */

    .form-title {
        margin-bottom: 25px;
    }

    .form-title h2 {
        margin: 0 0 5px;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .form-title p {
        margin: 0;
        color: #777;
        font-size: 0.9rem;
    }

    /* VALIDATION */

    .glass-validation {
        margin-bottom: 18px;
        color: #dc3545;
    }

    /* FORM */

    .form-group {
        margin-bottom: 22px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #444;
        font-weight: 600;
    }

    /* INPUT */

    .glass-input {
        min-height: 48px;
        padding: 11px 14px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.65);
        color: #222;
        box-shadow:
            inset 0 1px 2px rgba(0, 0, 0, 0.02);
        transition: 0.2s ease;
    }

    .glass-input:focus {
        border-color: rgba(0, 122, 255, 0.45);
        background: rgba(255, 255, 255, 0.85);
        box-shadow:
            0 0 0 4px rgba(0, 122, 255, 0.10),
            inset 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    /* CATEGORY */

    .category-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .category-row select {
        flex: 1;
    }

    .add-category-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;

        min-height: 48px;
        padding: 0 15px;

        border: 1px solid rgba(0, 122, 255, 0.18);
        border-radius: 13px;

        background: rgba(0, 122, 255, 0.08);
        color: #007aff;

        font-weight: 600;
        white-space: nowrap;

        cursor: pointer;
        transition: 0.2s ease;
    }

    .add-category-btn span {
        font-size: 20px;
        line-height: 1;
    }

    .add-category-btn:hover {
        background: rgba(0, 122, 255, 0.14);
        transform: translateY(-1px);
    }

    /* EQUIPMENT */

    .equipment-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        margin-bottom: 22px;
        padding: 16px 18px;

        border: 1px solid rgba(0, 0, 0, 0.07);
        border-radius: 16px;

        background: rgba(255, 255, 255, 0.5);

        transition: 0.2s ease;
    }

    .equipment-option:hover {
        background: rgba(255, 255, 255, 0.75);
        border-color: rgba(0, 122, 255, 0.15);
    }

    .equipment-info {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .equipment-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 44px;
        height: 44px;

        border-radius: 13px;

        background: rgba(0, 122, 255, 0.10);

        font-size: 21px;
    }

    .equipment-title {
        font-weight: 600;
        color: #333;
        margin-bottom: 3px;
    }

    .equipment-description {
        font-size: 0.82rem;
        color: #777;
    }

    /* SWITCH */

    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 28px;
        flex-shrink: 0;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        border-radius: 30px;
        background: #d1d1d6;
        transition: 0.25s ease;
    }

    .slider::before {
        content: "";

        position: absolute;

        width: 22px;
        height: 22px;

        left: 3px;
        top: 3px;

        border-radius: 50%;

        background: white;

        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.18);

        transition: 0.25s ease;
    }

    .switch input:checked+.slider {
        background: #007aff;
    }

    .switch input:checked+.slider::before {
        transform: translateX(22px);
    }

    /* ERROR */

    .text-danger {
        display: block;
        margin-top: 6px;
        font-size: 0.85rem;
    }

    /* BUTTONS */

    .form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 5px;
    }

    .save-btn {
        border: none;
        border-radius: 13px;
        padding: 11px 18px;

        background: linear-gradient(135deg, #007aff, #5856d6);

        color: white;
        font-weight: 600;

        box-shadow:
            0 8px 20px rgba(0, 122, 255, 0.18);

        transition: 0.2s ease;
    }

    .save-btn:hover {
        color: white;
        transform: translateY(-1px);

        box-shadow:
            0 10px 25px rgba(0, 122, 255, 0.26);
    }

    .cancel-btn {
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 13px;
        padding: 11px 18px;

        background: rgba(255, 255, 255, 0.55);

        color: #555;

        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .cancel-btn:hover {
        background: rgba(255, 255, 255, 0.85);
        color: #222;
    }

    /* MODAL */

    .category-modal-overlay {
        position: fixed;
        inset: 0;

        display: none;
        align-items: center;
        justify-content: center;

        padding: 20px;

        background: rgba(0, 0, 0, 0.25);

        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);

        z-index: 9999;
    }

    .category-modal-overlay.active {
        display: flex;
    }

    .category-modal {
        position: relative;

        width: 100%;
        max-width: 430px;

        padding: 28px;

        border: 1px solid rgba(255, 255, 255, 0.75);
        border-radius: 22px;

        background: rgba(255, 255, 255, 0.82);

        backdrop-filter: blur(30px) saturate(160%);
        -webkit-backdrop-filter: blur(30px) saturate(160%);

        box-shadow:
            0 25px 70px rgba(0, 0, 0, 0.16);
    }

    .category-modal-close {
        position: absolute;

        top: 15px;
        right: 17px;

        width: 34px;
        height: 34px;

        border: none;
        border-radius: 50%;

        background: rgba(0, 0, 0, 0.06);

        color: #555;

        font-size: 24px;
        line-height: 30px;

        cursor: pointer;
        transition: 0.2s ease;
    }

    .category-modal-close:hover {
        background: rgba(0, 0, 0, 0.11);
    }

    .modal-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 54px;
        height: 54px;

        margin-bottom: 15px;

        border-radius: 17px;

        background: rgba(0, 122, 255, 0.10);

        font-size: 24px;
    }

    .category-modal h3 {
        margin: 0 0 5px;

        font-size: 1.35rem;
        font-weight: 700;
    }

    .category-modal>p {
        margin: 0 0 22px;

        color: #777;
        font-size: 0.9rem;
    }

    .modal-form-group {
        margin-bottom: 20px;
    }

    .modal-form-group label {
        display: block;

        margin-bottom: 8px;

        color: #444;
        font-weight: 600;
    }

    .category-error {
        display: none;

        margin-top: 7px;

        color: #dc3545;
        font-size: 0.85rem;
    }

    .category-error.visible {
        display: block;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .modal-cancel-btn,
    .modal-save-btn {
        flex: 1;

        min-height: 46px;

        border-radius: 13px;

        font-weight: 600;

        cursor: pointer;

        transition: 0.2s ease;
    }

    .modal-cancel-btn {
        border: 1px solid rgba(0, 0, 0, 0.08);

        background: rgba(255, 255, 255, 0.65);

        color: #555;
    }

    .modal-cancel-btn:hover {
        background: rgba(255, 255, 255, 0.9);
    }

    .modal-save-btn {
        border: none;

        background: linear-gradient(135deg, #007aff, #5856d6);

        color: white;

        box-shadow:
            0 7px 18px rgba(0, 122, 255, 0.18);
    }

    .modal-save-btn:hover {
        transform: translateY(-1px);

        box-shadow:
            0 9px 23px rgba(0, 122, 255, 0.25);
    }

    .modal-save-btn:disabled {
        opacity: 0.6;
        cursor: wait;
        transform: none;
    }

    /* MOBILE */

    @@media (max-width: 600px) {

        .classroom-form-page {
            width: 100%;
        }

        .page-header h1 {
            font-size: 1.6rem;
        }

        .glass-form-card {
            padding: 20px;
            border-radius: 18px;
        }

        .category-row {
            flex-direction: column;
            align-items: stretch;
        }

        .add-category-btn {
            width: 100%;
        }

        .form-actions {
            flex-direction: column;
        }

        .form-actions .btn {
            width: 100%;
        }

        .equipment-option {
            padding: 14px;
        }

        .category-modal {
            padding: 23px;
        }

        .modal-actions {
            flex-direction: column;
        }
    }
</style>

@section Scripts {

    ```
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const modal =
            document.getElementById("categoryModal");

        const openModalButton =
            document.getElementById("openCategoryModal");

        const closeModalButton =
            document.getElementById("closeCategoryModal");

        const cancelButton =
            document.getElementById("cancelCategory");

        const saveButton =
            document.getElementById("saveCategory");

        const categoryInput =
            document.getElementById("newCategoryName");

        const categorySelect =
            document.getElementById("classroomCategorySelect");

        const categoryError =
            document.getElementById("categoryError");

        const antiForgeryToken =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;


        // Открытие окна

        function openCategoryModal() {

            modal.classList.add("active");

            categoryInput.value = "";

            categoryError.textContent = "";

            categoryError.classList.remove("visible");

            setTimeout(function () {

                categoryInput.focus();

            }, 100);
        }


        // Закрытие окна

        function closeCategoryModal() {

            modal.classList.remove("active");

            categoryInput.value = "";

            categoryError.textContent = "";

            categoryError.classList.remove("visible");
        }


        openModalButton.addEventListener(
            "click",
            openCategoryModal
        );


        closeModalButton.addEventListener(
            "click",
            closeCategoryModal
        );


        cancelButton.addEventListener(
            "click",
            closeCategoryModal
        );


        // Закрытие по клику на фон

        modal.addEventListener(
            "click",
            function (event) {

                if (event.target === modal) {

                    closeCategoryModal();

                }

            }
        );


        // Закрытие по Escape

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeCategoryModal();

                }

            }
        );


        // Добавление категории

        saveButton.addEventListener(
            "click",
            async function () {

                const name =
                    categoryInput.value.trim();


                if (!name) {

                    categoryError.textContent =
                        "Введите название категории.";

                    categoryError.classList.add("visible");

                    categoryInput.focus();

                    return;
                }


                saveButton.disabled = true;

                saveButton.textContent =
                    "Добавление...";


                try {

                    const response = await fetch(
                        "@Url.Action("CreateCategory", "Classrooms")",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken":
                                    antiForgeryToken
                            },

                            body: JSON.stringify({
                                name: name
                            })
                        }
                    );


                    const data =
                        await response.json();


                    if (
                        !response.ok ||
                        !data.success
                    ) {

                        categoryError.textContent =
                            data.message ||
                            "Не удалось добавить категорию.";

                        categoryError.classList.add(
                            "visible"
                        );

                        return;
                    }


                    // Создаём новый пункт списка

                    const option =
                        document.createElement("option");

                    option.value = data.id;

                    option.textContent = data.name;


                    categorySelect.appendChild(
                        option
                    );


                    // Автоматически выбираем новую категорию

                    categorySelect.value =
                        data.id;


                    closeCategoryModal();

                }
                catch (error) {

                    categoryError.textContent =
                        "Произошла ошибка. Попробуйте ещё раз.";

                    categoryError.classList.add(
                        "visible"
                    );

                }
                finally {

                    saveButton.disabled = false;

                    saveButton.textContent =
                        "Добавить категорию";

                }

            }
        );


        // Добавление категории по Enter

        categoryInput.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    saveButton.click();

                }

            }
        );

    </script>


}
