@model ScheduleSystem.Models.Subject

@{
    ViewData["Title"] = "Информация о предмете";
}

<div class="subject-details-page">

    <div class="page-header">
        <div>
            <h1>Информация о предмете</h1>
            <p>Подробная информация об учебном предмете</p>
        </div>
    </div>

    <div class="glass-details-card">

        <div class="subject-profile">

            <div class="subject-avatar">
                @(string.IsNullOrWhiteSpace(Model.Name)
                    ? "?"
                    : Model.Name.Substring(0, 1).ToUpper())
            </div>

            <div>
                <h2>@Model.Name</h2>
                <p>Учебный предмет</p>
            </div>

        </div>

        <div class="details-list">

            <div class="detail-row">
                <div class="detail-label">
                    Название
                </div>

                <div class="detail-value">
                    @Model.Name
                </div>
            </div>

        </div>

        <div class="details-actions">

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn edit-btn">
                Изменить
            </a>

            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn delete-btn">
                Удалить
            </a>

            <a asp-action="Index" class="btn cancel-btn">
                Назад к списку
            </a>

        </div>

    </div>

</div>

<style>
    .subject-details-page {
        max-width: 760px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0 0 5px;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .page-header p {
        margin: 0;
        color: #6c757d;
    }

    .glass-details-card {
        padding: 30px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(25px) saturate(160%);
        -webkit-backdrop-filter: blur(25px) saturate(160%);
        box-shadow:
            0 15px 40px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .subject-profile {
        display: flex;
        align-items: center;
        gap: 18px;
        padding-bottom: 25px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .subject-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        flex-shrink: 0;
        border-radius: 20px;
        background: linear-gradient(135deg, #007aff, #5856d6);
        color: white;
        font-size: 24px;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(0, 122, 255, 0.20);
    }

    .subject-profile h2 {
        margin: 0 0 5px;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .subject-profile p {
        margin: 0;
        color: #777;
    }

    .details-list {
        padding: 5px 0;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 20px;
        padding: 18px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #888;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .detail-value {
        color: #252525;
        font-weight: 600;
        word-break: break-word;
    }

    .details-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 20px;
    }

    .details-actions .btn {
        border-radius: 13px;
        padding: 11px 18px;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .edit-btn {
        border: none;
        background: rgba(0, 122, 255, 0.10);
        color: #007aff;
    }

    .edit-btn:hover {
        background: rgba(0, 122, 255, 0.16);
        color: #0066d6;
        transform: translateY(-1px);
    }

    .delete-btn {
        border: none;
        background: rgba(220, 53, 69, 0.09);
        color: #dc3545;
    }

    .delete-btn:hover {
        background: rgba(220, 53, 69, 0.15);
        color: #c82333;
        transform: translateY(-1px);
    }

    .cancel-btn {
        border: 1px solid rgba(255, 255, 255, 0.8);
        background: rgba(255, 255, 255, 0.55);
        color: #555;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .cancel-btn:hover {
        background: rgba(255, 255, 255, 0.85);
        color: #222;
    }

    media (max-width: 600px) {

        .subject-details-page {
            width: 100%;
        }

        .page-header h1 {
            font-size: 1.6rem;
        }

        .glass-details-card {
            padding: 20px;
            border-radius: 18px;
        }

        .detail-row {
            grid-template-columns: 1fr;
            gap: 6px;
        }

        .details-actions {
            flex-direction: column;
        }

        .details-actions .btn {
            width: 100%;
        }

    }
</style>