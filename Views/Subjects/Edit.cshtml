@model ScheduleSystem.Models.Subject

@{
    ViewData["Title"] = "Редактировать предмет";

    var classroomCategories =
        ViewBag.ClassroomCategories
        as IEnumerable<ScheduleSystem.Models.ClassroomCategory>
        ?? Enumerable.Empty<ScheduleSystem.Models.ClassroomCategory>();

    var selectedCategoryIds =
        ViewBag.SelectedClassroomCategoryIds
        as IEnumerable<int>
        ?? Enumerable.Empty<int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Subjects/Edit.css" asp-append-version="true" />
}

<div class="subject-form-page">

    <div class="page-header">
        <div>
            <h1>Редактировать предмет</h1>
            <p>Изменение информации о предмете</p>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="subject-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="validation-summary">
        </div>

        <!-- Основная информация -->
        <div class="form-card">

            <div class="form-group">

                <label asp-for="Name"></label>

                <input asp-for="Name" class="form-control" />

                <span asp-validation-for="Name" class="field-validation">
                </span>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Course"></label>

                    <select asp-for="Course" class="form-control">

                        <option value="1">1 курс</option>
                        <option value="2">2 курс</option>
                        <option value="3">3 курс</option>
                        <option value="4">4 курс</option>
                        <option value="5">5 курс</option>

                    </select>

                    <span asp-validation-for="Course" class="field-validation">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Type"></label>

                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<ScheduleSystem.Models.SubjectType>()"
                            class="form-control">
                    </select>

                    <span asp-validation-for="Type" class="field-validation">
                    </span>

                </div>

            </div>

        </div>

        <!-- Требования к аудитории -->
        <div class="requirements-list">

            @foreach (var category in classroomCategories)
            {
                var isSelected =
                    selectedCategoryIds.Contains(category.Id);

                <label class="requirement-card">

                    <div class="requirement-info">

                        <div class="requirement-icon">
                            🏫
                        </div>

                        <div class="requirement-text">

                            <div class="requirement-title">
                                Требуется @category.Name
                            </div>

                            <div class="requirement-description">
                                Занятие должно проводиться
                                в помещении категории
                                «@category.Name».
                            </div>

                        </div>

                    </div>

                    <span class="switch">

                        <input type="checkbox" name="selectedClassroomCategoryIds" value="@category.Id"
                               checked="@isSelected" />

                        <span class="slider"></span>

                    </span>

                </label>
            }

        </div>

        @if (!classroomCategories.Any())
        {
            <div class="empty-requirements">

                <div class="empty-requirements-icon">
                    🏫
                </div>

                <div>

                    <strong>
                        Категории аудиторий пока не созданы
                    </strong>

                    <p>
                        Добавьте категории аудиторий,
                        чтобы использовать их как требования предметов.
                    </p>

                </div>

            </div>
        }

        <div class="form-actions">

            <a asp-action="Index" class="btn btn-secondary">
                Отмена
            </a>

            <button type="submit" class="btn btn-primary">
                Сохранить изменения
            </button>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}