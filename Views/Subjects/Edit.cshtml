@model ScheduleSystem.Models.Subject

@{
    ViewData["Title"] = "Редактировать предмет";

    var classroomCategories =
        ViewBag.ClassroomCategories
        as IEnumerable<ScheduleSystem.Models.ClassroomCategory>
        ?? Enumerable.Empty<ScheduleSystem.Models.ClassroomCategory>();

    var selectedCategoryIds =
        ViewBag.SelectedClassroomCategoryIds
        as IEnumerable<int>
        ?? Enumerable.Empty<int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Subjects/Edit.css" asp-append-version="true" />
}

<div class="subject-form-page ui-form-layout">

    <!-- Заголовок -->
    <div class="page-header ui-page-heading">
        <div>
            <h1>Редактировать предмет</h1>
            <p>Измените основные данные и требования к аудитории</p>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="subject-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="validation-summary">
        </div>

        <!-- Основная информация -->
        <div class="form-card ui-surface ui-panel">

            <div class="section-heading">
                <div>
                    <h2>Основная информация</h2>
                    <p>Название, курс и тип учебного предмета</p>
                </div>
            </div>

            <div class="form-group">

                <label asp-for="Name"></label>

                <input asp-for="Name" class="form-control" autocomplete="off" />

                <span asp-validation-for="Name" class="field-validation">
                </span>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Course"></label>

                    <select asp-for="Course" class="form-control">

                        <option value="1">1 курс</option>
                        <option value="2">2 курс</option>
                        <option value="3">3 курс</option>
                        <option value="4">4 курс</option>
                        <option value="5">5 курс</option>

                    </select>

                    <span asp-validation-for="Course" class="field-validation">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Type"></label>

                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<ScheduleSystem.Models.SubjectType>()"
                            class="form-control">
                    </select>

                    <span asp-validation-for="Type" class="field-validation">
                    </span>

                </div>

            </div>

        </div>

        <!-- Требования к аудитории -->
        <div class="form-card ui-surface ui-panel classroom-requirements">

            <div class="section-heading requirements-heading">

                <div>
                    <h2>Требования к аудитории</h2>

                    <p>
                        Выберите категории аудиторий,
                        которые подходят для проведения предмета
                    </p>
                </div>

                <div class="selected-count">
                    Выбрано:
                    <strong id="selectedCount">0</strong>
                </div>

            </div>

            @if (classroomCategories.Any())
            {
                <div class="classroom-options">

                    @foreach (var category in classroomCategories)
                    {
                        var isSelected =
                            selectedCategoryIds.Contains(category.Id);

                        var icon = category.Name switch
                        {
                            "Компьютерный класс" => "⌨",
                            "Лаборатория" => "⚗",
                            "Лекционная аудитория" => "▤",
                            "Мастерская" => "⚒",
                            "Спортивный зал" => "◉",
                            "Учебный кабинет" => "▦",
                            "Кабинет дизайна" => "✦",
                            "Актовый зал" => "◫",
                            _ => "⌂"
                        };

                        <label class="classroom-option">

                            <div class="classroom-option-content">

                                <div class="classroom-option-icon">
                                    @icon
                                </div>

                                <div class="classroom-option-text">

                                    <div class="classroom-option-title">
                                        @category.Name
                                    </div>

                                    <div class="classroom-option-description">

                                        @switch (category.Name)
                                        {
                                            case "Компьютерный класс":
                                                @:Программирование, информатика, компьютерная графика.
                                                break;

                                            case "Лаборатория":
                                                @:Физика, химия, электротехника, практические лабораторные работы.
                                                break;

                                            case "Лекционная аудитория":
                                                @:Лекции, большие группы.
                                                break;

                                            case "Мастерская":
                                                @:Практические работы с оборудованием и инструментами.
                                                break;

                                            case "Спортивный зал":
                                                @:Физическая культура.
                                                break;

                                            case "Учебный кабинет":
                                                @:Обычные учебные занятия.
                                                break;

                                            case "Кабинет дизайна":
                                                @:Дизайн, компьютерная графика, Web-дизайн.
                                                break;

                                            case "Актовый зал":
                                                @:Мероприятия, собрания, презентации и защиты проектов.
                                                break;

                                            default:
                                                @:Аудитории этой категории будут учитываться при составлении расписания.
                                                break;
                                        }

                                    </div>

                                </div>

                            </div>

                            <span class="switch">

                                <input type="checkbox" name="selectedClassroomCategoryIds" value="@category.Id"
                                       class="category-checkbox" checked="@isSelected" />

                                <span class="slider"></span>

                            </span>

                        </label>
                    }

                </div>
            }
            else
            {
                <div class="empty-requirements">

                    <div class="empty-requirements-icon">
                        <i class="bi bi-door-open" aria-hidden="true"></i>
                    </div>

                    <div>
                        <strong>
                            Категории аудиторий пока не созданы
                        </strong>

                        <p>
                            Добавьте категории аудиторий,
                            чтобы использовать их как требования предметов.
                        </p>
                    </div>

                </div>
            }

        </div>

        <!-- Кнопки -->
        <div class="form-actions">

            <a asp-action="Index" class="btn ui-button btn-secondary">
                Отмена
            </a>

            <button type="submit" class="btn ui-button ui-primary btn-primary">
                Сохранить изменения
            </button>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const checkboxes =
                document.querySelectorAll(".category-checkbox");

            const counter =
                document.getElementById("selectedCount");

            function updateSelectedCount() {

                if (!counter) {
                    return;
                }

                const selected =
                    document.querySelectorAll(
                        ".category-checkbox:checked"
                    ).length;

                counter.textContent = selected;
            }

            checkboxes.forEach(function (checkbox) {

                checkbox.addEventListener(
                    "change",
                    updateSelectedCount
                );

            });

            updateSelectedCount();

        });
    </script>
}
