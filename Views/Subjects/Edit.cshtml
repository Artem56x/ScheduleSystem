@model ScheduleSystem.Models.Subject

@{
    ViewData["Title"] = "Редактировать предмет";
}

<div class="subject-form-page">

    <div class="page-header">
        <div>
            <h1>Редактировать предмет</h1>
            <p>Изменение информации о предмете</p>
        </div>
    </div>

    <div class="glass-form-card">

        <div class="form-icon">
            ✏️
        </div>

        <div class="form-title">
            <h2>Информация о предмете</h2>
            <p>Измените необходимые данные.</p>
        </div>

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="glass-validation"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label">
                    Название предмета
                </label>

                <input asp-for="Name" class="form-control glass-input" placeholder="Например: Информатика" />

                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="computer-option">

                <div class="computer-info">
                    <div class="computer-icon">
                        💻
                    </div>

                    <div>
                        <div class="computer-title">
                            Требуются компьютеры
                        </div>

                        <div class="computer-description">
                            Для проведения этого предмета необходим компьютерный класс
                        </div>
                    </div>
                </div>

                <label class="switch">
                    <input asp-for="RequiresComputers" />
                    <span class="slider"></span>
                </label>

            </div>

            <div class="form-actions">

                <button type="submit" class="btn save-btn">
                    Сохранить изменения
                </button>

                <a asp-action="Index" class="btn cancel-btn">
                    Отмена
                </a>

            </div>

        </form>

    </div>

   
</div>

<style>
    .subject-form-page {
        max-width: 700px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0 0 5px;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .page-header p {
        margin: 0;
        color: #6c757d;
    }

    .glass-form-card {
        padding: 30px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(25px) saturate(160%);
        -webkit-backdrop-filter: blur(25px) saturate(160%);
        box-shadow:
            0 15px 40px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .form-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        margin-bottom: 18px;
        border-radius: 20px;
        background: linear-gradient(135deg, #007aff, #5856d6);
        color: white;
        font-size: 27px;
        box-shadow: 0 8px 20px rgba(0, 122, 255, 0.20);
    }

    .form-title {
        margin-bottom: 25px;
    }

    .form-title h2 {
        margin: 0 0 5px;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .form-title p {
        margin: 0;
        color: #777;
        font-size: 0.9rem;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #444;
        font-weight: 600;
    }

    .glass-input {
        min-height: 48px;
        padding: 11px 14px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.65);
        color: #222;
        transition: 0.2s ease;
    }

    .glass-input:focus {
        border-color: rgba(0, 122, 255, 0.45);
        background: rgba(255, 255, 255, 0.85);
        box-shadow: 0 0 0 4px rgba(0, 122, 255, 0.10);
    }

    .text-danger {
        display: block;
        margin-top: 6px;
        font-size: 0.85rem;
    }

    .glass-validation {
        margin-bottom: 18px;
        color: #dc3545;
    }

    .computer-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        margin-bottom: 25px;
        padding: 17px 18px;

        border: 1px solid rgba(0, 0, 0, 0.07);
        border-radius: 16px;

        background: rgba(255, 255, 255, 0.48);

        transition: 0.2s ease;
    }

    .computer-option:hover {
        background: rgba(255, 255, 255, 0.7);
    }

    .computer-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .computer-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 46px;
        height: 46px;

        flex-shrink: 0;

        border-radius: 14px;
        background: rgba(0, 122, 255, 0.10);

        font-size: 21px;
    }

    .computer-title {
        margin-bottom: 3px;
        color: #333;
        font-weight: 600;
    }

    .computer-description {
        color: #777;
        font-size: 0.82rem;
        line-height: 1.35;
    }

    .switch {
        position: relative;

        display: inline-block;

        width: 50px;
        height: 30px;

        flex-shrink: 0;

        cursor: pointer;
    }

    .switch input {
        width: 0;
        height: 0;
        opacity: 0;
    }

    .slider {
        position: absolute;
        inset: 0;

        border-radius: 30px;

        background: #d1d1d6;

        transition: 0.25s ease;
    }

    .slider::before {
        content: "";

        position: absolute;

        width: 24px;
        height: 24px;

        left: 3px;
        top: 3px;

        border-radius: 50%;

        background: white;

        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.18);

        transition: 0.25s ease;
    }

    .switch input:checked+.slider {
        background: #007aff;
    }

    .switch input:checked+.slider::before {
        transform: translateX(20px);
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 5px;
    }

    .save-btn {
        border: none;
        border-radius: 13px;
        padding: 11px 18px;

        background: linear-gradient(135deg, #007aff, #5856d6);

        color: white;
        font-weight: 600;

        box-shadow: 0 8px 20px rgba(0, 122, 255, 0.18);

        transition: 0.2s ease;
    }

    .save-btn:hover {
        color: white;
        transform: translateY(-1px);
    }

    .cancel-btn {
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 13px;
        padding: 11px 18px;

        background: rgba(255, 255, 255, 0.55);

        color: #555;
    }

    .cancel-btn:hover {
        background: rgba(255, 255, 255, 0.85);
        color: #222;
    }

    @@media (max-width: 600px) {

        .glass-form-card {
            padding: 20px;
            border-radius: 18px;
        }

        .computer-option {
            align-items: flex-start;
        }

        .computer-info {
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
