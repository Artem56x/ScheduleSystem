@model ScheduleSystem.Models.Subject

@{
    ViewData["Title"] = "Добавить предмет";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Subjects/Create.css" asp-append-version="true" />
}

<div class="subject-form-page">

   
    <div class="page-header">
        <div>
            <h1>Добавить предмет</h1>
            <p>Создание нового предмета в системе</p>
        </div>
    </div>

    <div class="glass-form-card">

        <div class="form-icon">
            📚
        </div>

        <div class="form-title">
            <h2>Информация о предмете</h2>
            <p>Заполните данные нового предмета.</p>
        </div>

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="glass-validation"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label">
                    Название предмета
                </label>

                <input asp-for="Name" class="form-control glass-input" placeholder="Например: Информатика" />

                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="computer-option">

                <div class="computer-info">
                    <div class="computer-icon">
                        💻
                    </div>

                    <div>
                        <div class="computer-title">
                            Требуются компьютеры
                        </div>

                        <div class="computer-description">
                            Для проведения этого предмета необходим компьютерный класс
                        </div>
                    </div>
                </div>

                <label class="switch">
                    <input asp-for="RequiresComputers" />
                    <span class="slider"></span>
                </label>

            </div>

            <div class="form-actions">

                <button type="submit" class="btn save-btn">
                    Добавить предмет
                </button>

                <a asp-action="Index" class="btn cancel-btn">
                    Отмена
                </a>

            </div>

        </form>

    </div>

   
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
