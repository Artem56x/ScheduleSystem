@model ScheduleSystem.Models.Subject

@{
    ViewData["Title"] = "Добавить предмет";

    var classroomCategories =
        ViewBag.ClassroomCategories
        as IEnumerable<ScheduleSystem.Models.ClassroomCategory>
        ?? Enumerable.Empty<ScheduleSystem.Models.ClassroomCategory>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Subjects/Create.css" asp-append-version="true" />
}

<div class="subject-create-page">

    <!-- HEADER -->
    <header class="subject-create-header">

        <div>
            <h1>Добавить предмет</h1>

            <p>
                Заполните основные данные и укажите требования к аудитории
            </p>
        </div>

    </header>


    <form asp-action="Create" method="post" class="subject-create-form">

        @Html.AntiForgeryToken()


        <!-- VALIDATION -->
        <div asp-validation-summary="ModelOnly" class="validation-summary">
        </div>


        <!-- MAIN INFORMATION -->
        <section class="create-section">

            <div class="section-heading">

                <div>
                    <h2>Основная информация</h2>

                    <p>
                        Название, курс и тип учебного предмета
                    </p>
                </div>

            </div>


            <!-- NAME -->
            <div class="field field-name">

                <label asp-for="Name">
                    Название предмета
                </label>

                <input asp-for="Name" class="field-input" placeholder="Например, Математика" autocomplete="off"
                       autofocus />

                <span asp-validation-for="Name" class="field-error">
                </span>

            </div>


            <!-- COURSE / TYPE -->
            <div class="fields-row">

                <div class="field">

                    <label asp-for="Course">
                        Курс
                    </label>

                    <select asp-for="Course" class="field-input">

                        <option value="1">1 курс</option>
                        <option value="2">2 курс</option>
                        <option value="3">3 курс</option>
                        <option value="4">4 курс</option>
                        <option value="5">5 курс</option>

                    </select>

                    <span asp-validation-for="Course" class="field-error">
                    </span>

                </div>


                <div class="field">

                    <label asp-for="Type">
                        Тип предмета
                    </label>

                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<ScheduleSystem.Models.SubjectType>()"
                            class="field-input">
                    </select>

                    <span asp-validation-for="Type" class="field-error">
                    </span>

                </div>

            </div>

        </section>


        <!-- CLASSROOM REQUIREMENTS -->
        <section class="create-section classroom-section">

            <div class="section-heading classroom-heading">

                <div>

                    <h2>Требования к аудитории</h2>

                    <p>
                        Выберите категории аудиторий,
                        которые подходят для проведения предмета
                    </p>

                </div>

                @if (classroomCategories.Any())
                {
                    <span class="selection-counter">
                        <span id="selectedCount">0</span>
                        выбрано
                    </span>
                }

            </div>


            @if (classroomCategories.Any())
            {
                <div class="classroom-options">

                    @foreach (var category in classroomCategories)
                    {
                        <label class="classroom-option">

                            <div class="classroom-option-content">

                                <div class="classroom-option-icon">

                                    @switch (category.Name)
                                    {
                                        case "Компьютерный класс":
                                            <span>⌨</span>
                                            break;

                                        case "Лаборатория":
                                            <span>⚗</span>
                                            break;

                                        case "Лекционная аудитория":
                                            <span>▤</span>
                                            break;

                                        case "Мастерская":
                                            <span>⚒</span>
                                            break;

                                        case "Спортивный зал":
                                            <span>◉</span>
                                            break;

                                        case "Учебный кабинет":
                                            <span>▦</span>
                                            break;

                                        case "Кабинет дизайна":
                                            <span>✦</span>
                                            break;

                                        case "Актовый зал":
                                            <span>◫</span>
                                            break;

                                        default:
                                            <span>⌂</span>
                                            break;
                                    }

                                </div>


                                <div class="classroom-option-text">

                                    <span class="classroom-option-title">
                                        @category.Name
                                    </span>


                                    <span class="classroom-option-description">

                                        @switch (category.Name)
                                        {
                                            case "Компьютерный класс":
                                                @:Программирование, информатика, компьютерная графика.
                                                break;

                                            case "Лаборатория":
                                                @:Физика, химия, электротехника, практические лабораторные работы.
                                                break;

                                            case "Лекционная аудитория":
                                                @:Лекции, большие группы.
                                                break;

                                            case "Мастерская":
                                                @:Практические работы с оборудованием и инструментами.
                                                break;

                                            case "Спортивный зал":
                                                @:Физическая культура.
                                                break;

                                            case "Учебный кабинет":
                                                @:Обычные учебные занятия.
                                                break;

                                            case "Кабинет дизайна":
                                                @:Дизайн, компьютерная графика, Web-дизайн.
                                                break;

                                            case "Актовый зал":
                                                @:Мероприятия, собрания, презентации и защиты проектов.
                                                break;

                                            default:
                                                @:Аудитории этой категории будут учитываться при составлении расписания.
                                                break;
                                        }

                                    </span>

                                </div>

                            </div>


                            <!-- TOGGLE -->
                            <div class="toggle">

                                <input type="checkbox" name="selectedClassroomCategoryIds" value="@category.Id"
                                       class="category-checkbox" />

                                <span class="toggle-track">
                                    <span class="toggle-thumb"></span>
                                </span>

                            </div>

                        </label>
                    }

                </div>
            }
            else
            {
                <div class="classroom-empty">

                    <div class="classroom-empty-icon">
                        ⌂
                    </div>

                    <div>

                        <strong>
                            Категории аудиторий не созданы
                        </strong>

                        <p>
                            Предмет можно создать без требований
                            к определённой категории аудитории.
                        </p>

                    </div>

                </div>
            }

        </section>


        <!-- ACTIONS -->
        <div class="create-actions">

            <a asp-action="Index" class="action-secondary">
                Отмена
            </a>

            <button type="submit" class="action-primary">
                Добавить предмет
            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const checkboxes =
                document.querySelectorAll(".category-checkbox");

            const counter =
                document.getElementById("selectedCount");


            if (!counter) {
                return;
            }


            function updateSelectedCount() {

                const selected =
                    document.querySelectorAll(
                        ".category-checkbox:checked"
                    ).length;

                counter.textContent = selected;

            }


            checkboxes.forEach(function (checkbox) {

                checkbox.addEventListener(
                    "change",
                    updateSelectedCount
                );

            });


            updateSelectedCount();

        });

    </script>

}