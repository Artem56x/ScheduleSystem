@model ScheduleSystem.Models.Generator.ScheduleGenerationPreviewViewModel

@{
    ViewData["Title"] = "Предпросмотр расписания";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ScheduleGenerator/Preview.css" asp-append-version="true" />
}

<div class="generator-preview-page">

    <div class="preview-header">

        <div>
            <div class="preview-eyebrow">
                АВТОМАТИЧЕСКАЯ ГЕНЕРАЦИЯ
            </div>

            <h1>
                Предпросмотр расписания
            </h1>

            <p>
                Проверьте результат генерации перед сохранением
                в базу данных.
            </p>
        </div>

        <div class="preview-warning">
            <span>⚠</span>

            <div>
                <strong>Расписание ещё не сохранено</strong>

                <small>
                    Изменения появятся в основном расписании
                    только после подтверждения.
                </small>
            </div>
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- STATISTICS -->
    <!-- ===================================================== -->

    <div class="preview-statistics">

        <div class="stat-card">
            <span>Занятий</span>
            <strong>@Model.TotalLessons</strong>
        </div>

        <div class="stat-card">
            <span>Групп</span>
            <strong>@Model.TotalGroups</strong>
        </div>

        <div class="stat-card">
            <span>Преподавателей</span>
            <strong>@Model.TotalTeachers</strong>
        </div>

        <div class="stat-card">
            <span>Аудиторий</span>
            <strong>@Model.TotalClassrooms</strong>
        </div>

        <div class="stat-card">
            <span>Дней</span>
            <strong>@Model.TotalDays</strong>
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <div class="preview-card">

        <div class="preview-card-header">

            <div>
                <h2>Сгенерированное расписание</h2>

                <p>
                    Все найденные занятия без конфликтов.
                </p>
            </div>

            <div class="lesson-count">
                @Model.TotalLessons занятий
            </div>

        </div>


        @if (Model.Items.Count == 0)
        {
            <div class="empty-preview">
                <div class="empty-icon">○</div>

                <h3>Расписание пустое</h3>

                <p>
                    Генератор не создал ни одного занятия.
                </p>
            </div>
        }
        else
        {
            <div class="schedule-table-wrapper">

                <table class="schedule-table">

                    <thead>
                        <tr>
                            <th>День</th>
                            <th>Время</th>
                            <th>Группа</th>
                            <th>Предмет</th>
                            <th>Преподаватель</th>
                            <th>Аудитория</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items
                            .OrderBy(x => x.DayOfWeek)
                            .ThenBy(x => x.StartTime)
                            .ThenBy(x => x.GroupName))
                        {
                            <tr>

                                <td>
                                    <span class="day-badge">
                                        @GetDayName(item.DayOfWeek)
                                    </span>
                                </td>

                                <td>
                                    <span class="time-value">
                                        @item.StartTime.ToString(@"hh\:mm")
                                        –
                                        @item.EndTime.ToString(@"hh\:mm")
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @item.GroupName
                                    </strong>
                                </td>

                                <td>
                                    @item.SubjectName
                                </td>

                                <td>
                                    @item.TeacherName
                                </td>

                                <td>
                                    <span class="classroom-badge">
                                        @item.ClassroomName
                                    </span>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <!-- ===================================================== -->
    <!-- ACTIONS -->
    <!-- ===================================================== -->

    <div class="preview-actions">

        <a asp-action="Index" class="secondary-button">
            ← Изменить настройки
        </a>

        @if (Model.Items.Count > 0)
        {
            <form asp-action="Save" method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="primary-button">

                    <span>✓</span>

                    Подтвердить и сохранить

                </button>

            </form>
        }

    </div>

</div>


@functions {

    private static string GetDayName(DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Monday => "Понедельник",
            DayOfWeek.Tuesday => "Вторник",
            DayOfWeek.Wednesday => "Среда",
            DayOfWeek.Thursday => "Четверг",
            DayOfWeek.Friday => "Пятница",
            DayOfWeek.Saturday => "Суббота",
            DayOfWeek.Sunday => "Воскресенье",
            _ => day.ToString()
        };
    }
}