@model ScheduleSystem.Models.Generator.ScheduleGenerationPreviewViewModel

@{
    ViewData["Title"] = "Предпросмотр расписания";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ScheduleGenerator/Preview.css" asp-append-version="true" />
}

<div class="generator-preview-page">

    <div class="preview-header">

        <div>
            <div class="preview-eyebrow">
                АВТОМАТИЧЕСКАЯ ГЕНЕРАЦИЯ
            </div>

            <h1>
                Предпросмотр расписания
            </h1>

            <p>
                Проверьте автоматически созданное расписание
                перед сохранением.
            </p>
        </div>

        <div class="preview-header-actions">

            <form asp-action="CancelPreview" method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="glass-button secondary">
                    ← Вернуться к настройкам
                </button>

            </form>

        </div>

    </div>


    @if (TempData["GenerationValidationErrors"] is string validationErrors)
    {
        <div class="preview-alert error">
            <strong>
                Расписание больше нельзя сохранить.
            </strong>

            <div>
                @foreach (var error in validationErrors.Split('\n'))
                {
                    <div>@error</div>
                }
            </div>
        </div>
    }


    <div class="preview-stats">

        <div class="stat-card">
            <span class="stat-value">
                @Model.TotalLessons
            </span>

            <span class="stat-label">
                занятий
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-value">
                @Model.TotalGroups
            </span>

            <span class="stat-label">
                групп
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-value">
                @Model.TotalTeachers
            </span>

            <span class="stat-label">
                преподавателей
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-value">
                @Model.TotalClassrooms
            </span>

            <span class="stat-label">
                аудиторий
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-value">
                @Model.TotalDays
            </span>

            <span class="stat-label">
                дней
            </span>
        </div>

    </div>


    <div class="replacement-card">

        <div class="replacement-icon">
            ⚠️
        </div>

        <div class="replacement-content">

            <h2>
                Расписание будет заменено
            </h2>

            <p>
                Существующее расписание выбранных групп
                за выбранные дни будет удалено и заменено
                новым автоматически сгенерированным расписанием.
            </p>

            <div class="replacement-details">

                <div>
                    <span>Будет удалено</span>
                    <strong>
                        @Model.ExistingSchedulesToReplace
                    </strong>
                    <small>занятий</small>
                </div>

                <div>
                    <span>Будет записано</span>
                    <strong>
                        @Model.TotalLessons
                    </strong>
                    <small>занятий</small>
                </div>

            </div>

        </div>

    </div>


    <div class="scope-card">

        <div class="scope-section">

            <h3>
                Группы
            </h3>

            <div class="scope-list">

                @foreach (var groupId in Model.SelectedGroupIds)
                {
                    var item = Model.Items
                        .FirstOrDefault(x => x.GroupId == groupId);

                    if (item != null)
                    {
                        <span class="scope-chip">
                            @item.GroupName
                        </span>
                    }
                }

            </div>

        </div>


        <div class="scope-section">

            <h3>
                Дни
            </h3>

            <div class="scope-list">

                @foreach (var day in Model.SelectedDays.OrderBy(GetDayOrder))
                {
                    <span class="scope-chip">
                        @GetDayName(day)
                    </span>
                }

            </div>

        </div>

    </div>


    <div class="schedule-card">

        <div class="schedule-card-header">

            <div>
                <h2>
                    Новое расписание
                </h2>

                <p>
                    @Model.TotalLessons занятий
                </p>
            </div>

        </div>


        @foreach (var group in Model.Items
          .GroupBy(x => new { x.GroupId, x.GroupName })
          .OrderBy(x => x.Key.GroupName))
        {
            <section class="group-section">

                <div class="group-title">

                    <div class="group-title-main">
                        <div class="group-icon">
                            👥
                        </div>

                        <div>
                            <h3>
                                @group.Key.GroupName
                            </h3>

                            <span>
                                @group.Count() занятий
                            </span>
                        </div>
                    </div>

                </div>


                <div class="group-days">

                    @foreach (var dayGroup in group
                        .GroupBy(x => x.DayOfWeek)
                        .OrderBy(x => GetDayOrder(x.Key)))
                    {
                        <section class="group-day-section">

                            <div class="group-day-title">

                                <span class="day-dot"></span>

                                <h4>
                                    @GetDayName(dayGroup.Key)
                                </h4>

                                <span class="day-count">
                                    @dayGroup.Count()
                                </span>

                            </div>


                            <div class="lesson-list">

                                @foreach (var lesson in dayGroup
                                    .OrderBy(x => x.StartTime)
                                    .ThenBy(x => x.LessonNumber))
                                {
                                    <div class="lesson-row">

                                        <div class="lesson-time">
                                            <strong>
                                                @lesson.StartTime.ToString(@"hh\:mm")
                                            </strong>

                                            <span>
                                                @lesson.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        </div>


                                        <div class="lesson-main">

                                            <div class="lesson-subject">
                                                @lesson.SubjectName
                                            </div>

                                            <div class="lesson-meta">

                                                <span>
                                                    👨‍🏫 @lesson.TeacherName
                                                </span>

                                                <span>
                                                    🏫 @lesson.ClassroomName
                                                </span>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </section>
                    }

                </div>

            </section>
        }

    </div>


    <div class="preview-actions">

        <form asp-action="CancelPreview" method="post">

            @Html.AntiForgeryToken()

            <button type="submit" class="glass-button secondary large">
                Отменить
            </button>

        </form>


        <button type="button" class="glass-button primary large" id="openSaveModal">

            Подтвердить и сохранить

        </button>

    </div>

</div>


<div class="confirm-modal" id="saveModal" aria-hidden="true">

    <div class="confirm-overlay" id="closeSaveModal"></div>

    <div class="confirm-dialog">

        <div class="confirm-icon">
            ⚠️
        </div>

        <h2>
            Расписание будет заменено
        </h2>

        <p>
            Существующее расписание выбранных групп
            за выбранные дни будет удалено и заменено
            новым автоматически сгенерированным расписанием.
        </p>

        <div class="confirm-summary">

            <div>
                <span>Будет удалено</span>
                <strong>
                    @Model.ExistingSchedulesToReplace
                </strong>
            </div>

            <div>
                <span>Будет записано</span>
                <strong>
                    @Model.TotalLessons
                </strong>
            </div>

        </div>

        <div class="confirm-actions">

            <button type="button" class="glass-button secondary" id="cancelSaveModal">
                Отменить
            </button>


            <form asp-action="ConfirmAndSave" method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="glass-button danger">
                    Удалить и записать новое
                </button>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const modal =
            document.getElementById("saveModal");

        const openButton =
            document.getElementById("openSaveModal");

        const closeButton =
            document.getElementById("closeSaveModal");

        const cancelButton =
            document.getElementById("cancelSaveModal");


        function openModal() {

            modal.classList.add("is-open");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.classList.add(
                "modal-open"
            );
        }


        function closeModal() {

            modal.classList.remove("is-open");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.classList.remove(
                "modal-open"
            );
        }


        openButton?.addEventListener(
            "click",
            openModal
        );

        closeButton?.addEventListener(
            "click",
            closeModal
        );

        cancelButton?.addEventListener(
            "click",
            closeModal
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {
                    closeModal();
                }

            }
        );

    </script>

}

@functions {

    private static int GetDayOrder(
        DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Monday => 1,
            DayOfWeek.Tuesday => 2,
            DayOfWeek.Wednesday => 3,
            DayOfWeek.Thursday => 4,
            DayOfWeek.Friday => 5,
            DayOfWeek.Saturday => 6,
            DayOfWeek.Sunday => 7,
            _ => 8
        };
    }

    private static string GetDayName(
        DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Monday => "Понедельник",
            DayOfWeek.Tuesday => "Вторник",
            DayOfWeek.Wednesday => "Среда",
            DayOfWeek.Thursday => "Четверг",
            DayOfWeek.Friday => "Пятница",
            DayOfWeek.Saturday => "Суббота",
            DayOfWeek.Sunday => "Воскресенье",
            _ => day.ToString()
        };
    }

}