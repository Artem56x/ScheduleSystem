<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ScheduleSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="background-orb orb-1"></div>
    <div class="background-orb orb-2"></div>

    <header class="glass-navbar">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">

                    <span class="brand-icon">S</span>
                    <span>ScheduleSystem</span>

                </a>

                <!-- MOBILE MENU -->
                <button class="navbar-toggler glass-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false"
                        aria-label="Открыть меню">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    <!-- MAIN NAVIGATION -->
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">

                                <span>Главная</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Schedules" asp-action="Index">

                                <span>Расписание</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Teachers" asp-action="Index">

                                <span>Преподаватели</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Groups" asp-action="Index">

                                <span>Группы</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Subjects" asp-action="Index">

                                <span>Предметы</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Classrooms" asp-action="Index">

                                <span>Аудитории</span>

                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- USER MENU -->
                            <li class="nav-item dropdown ms-lg-2">

                                <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="profile-avatar">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </span>

                                    <span class="profile-name">
                                        @(User.Identity.Name ?? "Пользователь")
                                    </span>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end glass-dropdown">

                                    <li class="profile-dropdown-header">

                                        <div class="profile-avatar large">
                                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                        </div>

                                        <div>
                                            <div class="profile-email">
                                                @(User.Identity.Name ?? "Пользователь")
                                            </div>

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <div class="profile-role admin">
                                                    Администратор
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="profile-role">
                                                    Пользователь
                                                </div>
                                            }
                                        </div>

                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <!-- ПРОФИЛЬ -->

                                    <li>
                                        <a asp-controller="Account" asp-action="Profile" class="dropdown-item">

                                            <span class="menu-icon">👤</span>
                                            <span>Профиль</span>

                                        </a>
                                    </li>


                                    <!-- НАСТРОЙКИ ПРОФИЛЯ -->

                                    <li>
                                        <a asp-controller="Account" asp-action="Settings" class="dropdown-item">

                                            <span class="menu-icon">⚙</span>
                                            <span>Настройки профиля</span>

                                        </a>
                                    </li>


                                    <!-- НАСТРОЙКИ ПРОГРАММЫ ТОЛЬКО ДЛЯ ADMIN -->

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a asp-controller="Account" asp-action="Settings" class="dropdown-item">

                                                <span class="menu-icon">⚙</span>
                                                <span>Настройки профиля</span>

                                            </a>
                                        </li>
                                    }


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <!-- ВЫХОД -->

                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="dropdown-item logout-item">

                                                <span class="menu-icon">↪</span>
                                                <span>Выйти</span>

                                            </button>

                                        </form>
                                    </li>

                                </ul>

                            </li>
                        }
                        else
                        {
                            <!-- GUEST AUTH BUTTONS -->
                            <li class="nav-item ms-lg-2">
                                <a class="auth-button login-button" asp-controller="Account" asp-action="Login">

                                    <span>Войти</span>

                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="auth-button register-button" asp-controller="Account" asp-action="Register">

                                    <span>Регистрация</span>

                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="glass-footer">
        <div class="container text-center">
            <span>© 2026 ScheduleSystem</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>