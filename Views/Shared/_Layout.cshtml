<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScheduleSystem</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/liquid-glass.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app-background" aria-hidden="true">
        <div class="background-orb orb-1"></div>
        <div class="background-orb orb-2"></div>
        <div class="background-orb orb-3"></div>
    </div>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="brand-link"><span class="brand-mark">S</span><span
                    class="brand-copy"><strong>ScheduleSystem</strong><small>Учебное расписание</small></span></a>
                    <button class="sidebar-close" type="button" aria-label="Закрыть меню" data-sidebar-close>×</button>
                </div>
                <div class="sidebar-section-label">Навигация</div>
                <nav class="sidebar-nav" aria-label="Основная навигация">
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    }
    
                    <a class="sidebar-link @(currentController == "Home" ? "active" : "")" asp-controller="Home"
                       asp-action="Index">
                        <i class="sidebar-icon bi bi-house-door"></i>
                        <span>Главная</span>
                    </a>

                    <a class="sidebar-link @(currentController == "Schedules" ? "active" : "")" asp-controller="Schedules"
                       asp-action="Index">
                        <i class="sidebar-icon bi bi-calendar-week"></i>
                        <span>Расписание</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="sidebar-link @(currentController == "Analytics" ? "active" : "")" asp-controller="Analytics"
                           asp-action="Index">
                            <i class="sidebar-icon bi bi-bar-chart-line"></i>
                            <span>Аналитика</span>
                        </a>
                    }

                    <a class="sidebar-link @(currentController == "Teachers" ? "active" : "")" asp-controller="Teachers"
                       asp-action="Index">
                        <i class="sidebar-icon bi bi-person-badge"></i>
                        <span>Преподаватели</span>
                    </a>

                    <a class="sidebar-link @(currentController == "Groups" ? "active" : "")" asp-controller="Groups"
                       asp-action="Index">
                        <i class="sidebar-icon bi bi-people"></i>
                        <span>Группы</span>
                    </a>

                    <a class="sidebar-link @(currentController == "Subjects" ? "active" : "")" asp-controller="Subjects"
                       asp-action="Index">
                        <i class="sidebar-icon bi bi-journal-bookmark"></i>
                        <span>Предметы</span>
                    </a>

                    <a class="sidebar-link @(currentController == "Classrooms" ? "active" : "")" asp-controller="Classrooms"
                       asp-action="Index">
                        <i class="sidebar-icon bi bi-door-open"></i>
                        <span>Аудитории</span>
                    </a>
                </nav>

                <div class="sidebar-bottom">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="sidebar-link sidebar-settings @(currentController == "Account" ? "active" : "")"
                           asp-controller="Account" asp-action="Settings">
                            <i class="sidebar-icon bi bi-gear"></i>
                            <span>Настройки</span>
                        </a>
                    }
                </div>
            </aside>
            <div class="sidebar-backdrop" data-sidebar-close></div>
            <div class="app-main">
                <header class="app-topbar">
                    <div class="topbar-left">
                        <button class="mobile-menu-button" type="button" aria-label="Открыть меню"
                                data-sidebar-open>☰</button>
                        <div class="page-context"><strong>@ViewData["Title"]</strong></div>
                    </div>
                    <div class="topbar-right">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="topbar-notifications">@await Component.InvokeAsync("NotificationBell")</div>
                            <div class="dropdown">
                                <button class="topbar-profile dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                        aria-expanded="false"><span class="profile-avatar">@(User.Identity.Name?.Substring(0,
                                        1).ToUpper() ?? "U")</span><span
                                    class="topbar-profile-copy"><strong>@(User.Identity.Name ??
                                    "Пользователь")</strong><small>@(User.IsInRole("Admin") ? "Администратор" :
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "Пользователь")</small></span></button>
                                    <ul class="dropdown-menu dropdown-menu-end glass-dropdown">
                                        <li><a asp-controller="Account" asp-action="Profile" class="dropdown-item">👤 Профиль</a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                                @Html.AntiForgeryToken()<button type="submit" class="dropdown-item logout-item">↪
                                                Выйти</button></form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                    else
                                {

                                    <a class="topbar-auth-link" asp-controller="Account" asp-action="Login">Войти</a><a
                                    class="glass-primary-button" asp-controller="Account" asp-action="Register">Регистрация</a>
                                }
                            </div>
                        </header>
                        <main class="main-content">@RenderBody()</main>
                        <footer class="glass-footer"><span>© 2026 ScheduleSystem</span><span>Система управления учебным
                            расписанием</span></footer>
                        </div>
                    </div>
                    <script src="~/lib/jquery/dist/jquery.min.js"></script>
                    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                    <script src="~/js/site.js" asp-append-version="true"></script>
                    <script>(() => { const shell = document.querySelector('.app-shell'); document.querySelectorAll('[data-sidebar-open]').forEach(b => b.addEventListener('click', () => shell?.classList.add('sidebar-open'))); document.querySelectorAll('[data-sidebar-close]').forEach(b => b.addEventListener('click', () => shell?.classList.remove('sidebar-open'))); })();</script>
                    @await RenderSectionAsync("Scripts", required: false)
                </body>

            </html>
