@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<section class="ui-service-page ui-surface" aria-labelledby="errorTitle">
<h1 id="errorTitle">Не удалось выполнить запрос</h1>
<p>Попробуйте повторить действие. Если ошибка повторяется, сообщите администратору идентификатор запроса.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Идентификатор запроса:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index" class="ui-button ui-primary">На главную</a>
</section>
