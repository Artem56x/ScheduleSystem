@model IEnumerable<ScheduleSystem.Models.Schedule>

@{
    ViewData["Title"] = "Главная";


    var dayNames = new Dictionary<DayOfWeek, string>
{
    { DayOfWeek.Monday, "Понедельник" },
    { DayOfWeek.Tuesday, "Вторник" },
    { DayOfWeek.Wednesday, "Среда" },
    { DayOfWeek.Thursday, "Четверг" },
    { DayOfWeek.Friday, "Пятница" },
    { DayOfWeek.Saturday, "Суббота" },
    { DayOfWeek.Sunday, "Воскресенье" }
};

    var groupSchedules = Model
        .GroupBy(s => s.Group?.Name ?? "Группа не указана")
        .OrderBy(g => g.Key)
        .ToList();


}

@section Styles {
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

<div class="dashboard-page">

 
    <!-- =====================================================
     WELCOME
     ===================================================== -->

    <section class="welcome-section">

        <span class="welcome-badge">
            УЧЕБНОЕ РАСПИСАНИЕ
        </span>

        <h1>
            Добро пожаловать 👋
        </h1>

    </section>


    <!-- =====================================================
     SCHEDULE HEADER
     ===================================================== -->

    <section class="schedule-header">

        <div class="schedule-heading">

            <div class="schedule-title-row">

                <div class="schedule-title-icon">
                    📅
                </div>

                <div class="schedule-title-content">

                    <h2>
                        Расписание занятий
                    </h2>

                    <p>
                        Занятия сгруппированы по учебным группам
                    </p>

                </div>

            </div>

        </div>


        <a asp-controller="Schedules" asp-action="Index" class="all-schedule-button">

            <span>
                Всё расписание
            </span>

            <span class="all-schedule-arrow">
                →
            </span>

        </a>

    </section>


    <!-- =====================================================
     EMPTY STATE
     ===================================================== -->

    @if (!Model.Any())
    {
        <section class="empty-schedule">

            <div class="empty-icon">
                📅
            </div>

            <h3>
                Расписание пока пустое
            </h3>

            <p>
                В системе пока нет добавленных занятий.
            </p>

        </section>
    }
    else
    {
        <!-- =================================================
         GROUPS
         ================================================= -->

        <section class="groups-grid">

            @foreach (var group in groupSchedules)
            {
                var days = group
                    .GroupBy(s => s.DayOfWeek)
                    .OrderBy(g =>
                        !g.Key.HasValue
                            ? 8
                            : g.Key.Value == DayOfWeek.Sunday
                                ? 7
                                : (int)g.Key.Value)
                    .ToList();

                var count = group.Count();

                var countMod100 = count % 100;
                var countMod10 = count % 10;

                string countSuffix =
                    (countMod100 >= 11 && countMod100 <= 14)
                        ? "занятий"
                        : countMod10 switch
                        {
                            1 => "занятие",
                            >= 2 and <= 4 => "занятия",
                            _ => "занятий"
                        };

                <article class="group-card">

                    <!-- GROUP HEADER -->

                    <header class="group-header">

                        <div class="group-icon">
                            👥
                        </div>

                        <div class="group-title-container">

                            <h3>
                                @group.Key
                            </h3>

                            <span>
                                @count @countSuffix
                            </span>

                        </div>

                        <div class="group-lessons-count">
                            @count
                        </div>

                    </header>


                    <!-- GROUP SCHEDULE -->

                    <div class="group-schedule">

                        @foreach (var day in days)
                        {
                            string dayName;

                            if (day.Key.HasValue &&
                                dayNames.TryGetValue(day.Key.Value, out var name))
                            {
                                dayName = name;
                            }
                            else
                            {
                                dayName = "День не указан";
                            }

                            <section class="day-section">

                                <!-- DAY HEADER -->

                                <div class="day-header">

                                    <h4 class="day-title">
                                        @dayName
                                    </h4>

                                    <span class="day-count">
                                        @day.Count()
                                    </span>

                                </div>


                                <!-- LESSONS -->

                                <div class="lessons-container">

                                    @foreach (var lesson in day.OrderBy(s =>
                                        s.StartTime.HasValue
                                            ? s.StartTime.Value
                                            : TimeSpan.MaxValue))
                                    {
                                        <article class="lesson-card">

                                            <!-- TIME -->

                                            <div class="lesson-time">

                                                <time class="lesson-start">
                                                    @(lesson.StartTime.HasValue
                                                        ? lesson.StartTime.Value.ToString(@"hh\:mm")
                                                        : "--:--")
                                                </time>

                                                <span class="lesson-line"></span>

                                                <time class="lesson-end">
                                                    @(lesson.EndTime.HasValue
                                                        ? lesson.EndTime.Value.ToString(@"hh\:mm")
                                                        : "--:--")
                                                </time>

                                            </div>


                                            <!-- LESSON INFO -->

                                            <div class="lesson-info">

                                                <div class="lesson-top">

                                                    <h5 class="lesson-subject">
                                                        @(lesson.Subject?.Name ?? "Предмет не указан")
                                                    </h5>

                                                </div>


                                                <div class="lesson-details">

                                                    <!-- TEACHER -->

                                                    <div class="lesson-detail">

                                                        <span class="detail-icon">
                                                            👨‍🏫
                                                        </span>

                                                        <span class="detail-text">
                                                            @(lesson.Teacher?.FullName ?? "Преподаватель не указан")
                                                        </span>

                                                    </div>


                                                    <!-- CLASSROOM -->

                                                    <div class="lesson-detail">

                                                        <span class="detail-icon">
                                                            🏫
                                                        </span>

                                                        <span class="detail-text">
                                                            @(lesson.Classroom?.Name ?? "Аудитория не указана")
                                                        </span>

                                                    </div>

                                                </div>


                                                <!-- DETAILS BUTTON -->

                                                <a asp-controller="Schedules" asp-action="Details" asp-route-id="@lesson.Id"
                                                   class="lesson-details-button">

                                                    <span>
                                                        Подробнее
                                                    </span>

                                                    <span class="lesson-button-arrow">
                                                        →
                                                    </span>

                                                </a>

                                            </div>

                                        </article>
                                    }

                                </div>

                            </section>
                        }

                    </div>

                </article>
            }

        </section>
    }

</div>